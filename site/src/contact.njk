---
layout: base.njk
title: Mindchord – Contact 
nav: contact
---

{% block head %}
    <link rel="stylesheet" href="/styles/contact_style.css">
{% endblock %}

<main class="flex-1 relative px-6 md:px-10 pt-20 md:pt-28 pb-24">
    <div class="max-w-2xl mx-auto">

        <!-- Header + intro (centred) -->
        <div class="text-center">
            <h1 class="wordmark text-4xl md:text-5xl tracking-tight">Contact us</h1>
            <p class="wordmark mt-5 text-lg text-[#6B635A] leading-relaxed">
                Posttrain is in beta. Whether you're a clinic looking to offer it to your clients, a clinician evaluating it for your practice, or someone interested in trying neurofeedback yourself — drop us a line and we'll get back to you.
            </p>
            <p class="wordmark mt-4 text-[17px] text-[#2C2825]/85 leading-relaxed">
                You can email us directly at
                <a href="mailto:simchaorgel@gmail.com" class="text-[#C4704B] underline decoration-[#C4704B]/40 underline-offset-4 hover:decoration-[#C4704B] transition">simchaorgel@gmail.com</a>,
                or use the form below.
            </p>
        </div>

        <!-- Contact form — handled by Netlify Forms.
                `data-netlify="true"` registers it at deploy. The hidden
                `form-name` input is required for the POST. The honeypot
                (`bot-field`) traps bots; real submissions leave it empty.
                Labels stay left-aligned within fields for readability;
                the form block itself is centred on the page. -->
        <form name="contact"
                method="POST"
                data-netlify="true"
                data-netlify-honeypot="bot-field"
                class="mt-12 space-y-6">

            <input type="hidden" name="form-name" value="contact" />

            <p class="hp-field">
                <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                    <label for="contact-name" class="field-label">Name</label>
                    <input id="contact-name" name="name" type="text" required class="field-input" autocomplete="name" />
                </div>
                <div>
                    <label for="contact-email" class="field-label">Email</label>
                    <input id="contact-email" name="email" type="email" required class="field-input" autocomplete="email" />
                </div>
            </div>

            <div>
                <label for="contact-message" class="field-label">Message</label>
                <textarea id="contact-message" name="message" required class="field-textarea"></textarea>
            </div>

            <div class="pt-2 flex justify-center">
                <button type="submit"
                        class="relative isolate inline-flex items-center gap-2 px-7 py-3 text-[15px] text-[#F5F0EB] wordmark rounded-full ring-4 ring-transparent hover:ring-[#7A8F7E]/30 active:scale-95 transition-all duration-200 before:content-[''] before:absolute before:inset-0 before:-z-10 before:rounded-full before:bg-gradient-to-b before:from-[#869C8A] before:to-[#6A7F6E] before:transition-all before:duration-200 hover:before:brightness-90">
                    Send message
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                        <path d="M13.2 5.3a1 1 0 0 1 1.4 0l5.8 5.8a1.25 1.25 0 0 1 0 1.77l-5.8 5.83a1 1 0 0 1-1.42-1.41L17.18 13H4.75a1 1 0 1 1 0-2h12.43l-3.98-3.98a1 1 0 0 1 0-1.42Z"/>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</main>
