<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <link rel="icon" type="image/png" href="/media/favicon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles/global_style.css">
    {% block head %}{% endblock %}

    <!-- In-app embed: if loaded with ?inapp=true, hide the marketing-site chrome
         (header, mobile menu, footer) so the page can be iframed inside the app. -->
    <style>
        html.inapp > body > header,
        html.inapp > body > footer,
        html.inapp > body > #mobile-menu { display: none !important; }
    </style>
    <script>
        (function () {
            try {
                if (new URLSearchParams(location.search).get('inapp') === 'true') {
                    document.documentElement.classList.add('inapp');
                }
            } catch (e) {}
        })();
    </script>
</head>

<body class="page-bg min-h-screen text-[#2C2825] flex flex-col">
    <!-- Background blobs -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <!-- Header -->
    <header class="glass sticky top-0 z-50">
        <div class="px-6 md:px-10 h-16 flex items-center gap-6 md:gap-12">
            <a href="/" class="flex items-center gap-2.5 shrink-0">
                <img src="/media/favicon.png" alt="" class="h-8 md:h-9 w-auto object-contain">
                <span class="wordmark text-xl md:text-2xl">Mindchord</span>
            </a>
            <nav class="hidden md:flex items-center gap-8 text-[15px]">
                <a href="/" class="nav-link {% if nav == 'home' %}is-active{% endif %}">Home</a>
                <a href="/#about" class="nav-link {% if nav == 'about' %}is-active{% endif %}">About</a>
                <a href="/get-started/" class="nav-link {% if nav == 'get-started' %}is-active{% endif %}">Get started</a>
                <a href="/contact/" class="nav-link {% if nav == 'feature-requests' %}is-active{% endif %}">Feature Requests</a>
                <a href="/contact/" class="nav-link {% if nav == 'contact' %}is-active{% endif %}">Contact Us</a>
            </nav>
            <div class="ml-auto flex items-center gap-3">
                <a href="/console/login/" class="console-btn inline-flex items-center gap-2 px-3 md:px-5 py-2 rounded-full text-[15px]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                        <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v9A2.5 2.5 0 0 1 18.5 17H13l.5 2.5h2a.75.75 0 0 1 0 1.5h-7a.75.75 0 0 1 0-1.5h2L11 17H5.5A2.5 2.5 0 0 1 3 14.5v-9Zm2.5-1a1 1 0 0 0-1 1v8h15v-8a1 1 0 0 0-1-1h-13Z"/>
                    </svg>
                    <span class="hidden sm:inline">Mindchord Console</span>
                </a>
                <button id="menu-btn" type="button" aria-label="Open menu" class="md:hidden p-2 -mr-2 text-[#2C2825]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                        <path d="M3.75 6.75a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm0 5.25a.75.75 0 0 1 .75-.75h15a.75.75 0 0 1 0 1.5h-15a.75.75 0 0 1-.75-.75Zm.75 4.5a.75.75 0 0 0 0 1.5h15a.75.75 0 0 0 0-1.5h-15Z"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="fixed inset-0 z-[60] opacity-0 pointer-events-none transition-opacity duration-200 ease-out bg-[#F5F0EB]/95 backdrop-blur-md flex flex-col">
        <div class="px-6 h-16 flex items-center justify-between border-b border-[#6B635A]/15 shrink-0">
            <div class="flex items-center gap-2.5">
                <img src="/media/favicon.png" alt="" class="h-8 w-auto object-contain">
                <span class="wordmark text-xl">Mindchord</span>
            </div>
            <button type="button" aria-label="Close menu" onclick="closeMobileMenu()" class="p-2 -mr-2 text-[#2C2825]">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L10.94 12l-5.72 5.72a.75.75 0 1 0 1.06 1.06L12 13.06l5.72 5.72a.75.75 0 1 0 1.06-1.06L13.06 12l5.72-5.72a.75.75 0 0 0-1.06-1.06L12 10.94 6.28 5.22Z"/>
                </svg>
            </button>
        </div>
        <nav class="flex-1 px-8 py-10 wordmark text-2xl flex flex-col gap-6 text-[#2C2825]">
            <a href="/" class="{% if nav == 'home' %}is-active{% endif %}" onclick="closeMobileMenu()">Home</a>
            <a href="/#about" onclick="closeMobileMenu()">About</a>
            <a href="/get-started/" class="{% if nav == 'get-started' %}is-active{% endif %}" onclick="closeMobileMenu()">Get started</a>
            <a href="/contact/" onclick="closeMobileMenu()">Feature Requests</a>
            <a href="/contact/" class="{% if nav == 'contact' %}is-active{% endif %}" onclick="closeMobileMenu()">Contact Us</a>
        </nav>
    </div>

    {{ content | safe }}

    <!-- Footer -->
    <footer class="border-t border-[#6B635A]/20 px-6 md:px-10 py-6 flex items-center justify-between wordmark text-sm text-[#6B635A]">
        <div class="flex items-center gap-5">
            <span>© 2026 Mindchord</span>
            <a href="/legal/" class="hover:text-[#2C2825] transition">Terms and privacy</a>
        </div>
        <button type="button" id="back-to-top" class="inline-flex items-center gap-1.5 hover:text-[#2C2825] transition">
            Back to top
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M18.7 13.2a1 1 0 0 1-1.4 0L12 7.92l-5.28 5.28a1 1 0 1 1-1.42-1.42l5.83-5.83a1.25 1.25 0 0 1 1.77 0l5.83 5.83a1 1 0 0 1-.03 1.42Z"/>
            </svg>
        </button>
    </footer>

    <!-- Scripts -->
    <script src="/scripts/global_script.js"></script>

</body>
</html>