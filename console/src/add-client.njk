layout: sidebar.njk
title: Mindchord Console — Add client
nav: clients
---

<!-- Breadcrumb back to the client list -->
<a href="/console/clients/"
    class="wordmark inline-flex items-center gap-1.5 text-sm text-[#6B635A] hover:text-[#2C2825] transition">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
        <path d="M14.7 17.7a1 1 0 0 1-1.4 0L8 12.4a.5.5 0 0 1 0-.8l5.3-5.3a1 1 0 1 1 1.4 1.42L10.82 12l3.88 3.88a1 1 0 0 1 0 1.42Z"/>
    </svg>
    All clients
</a>

<h1 class="wordmark mt-4 text-4xl md:text-5xl tracking-tight">Add client</h1>
<p class="wordmark mt-3 text-[#6B635A] text-base max-w-xl">
    Create a new client account. They'll be able to sign in to the Mindchord app
    with this email address using a one-time code — no password needed.
</p>

<form id="add-client-form" class="mt-10 card p-6 md:p-8 max-w-xl" novalidate>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label class="block">
            <span class="wordmark text-sm text-[#2C2825]">First name</span>
            <input id="ac-firstname" type="text" autocomplete="given-name" placeholder="Jane"
                class="wordmark mt-2 w-full h-12 px-4 bg-[#F7F5F2] rounded-lg border border-[#2C2825]/10 focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
        </label>
        <label class="block">
            <span class="wordmark text-sm text-[#2C2825]">Surname</span>
            <input id="ac-surname" type="text" autocomplete="family-name" placeholder="Doe"
                class="wordmark mt-2 w-full h-12 px-4 bg-[#F7F5F2] rounded-lg border border-[#2C2825]/10 focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
        </label>
    </div>

    <label class="block mt-5">
        <span class="wordmark text-sm text-[#2C2825]">Email address</span>
        <input id="ac-email" type="email" required autocomplete="off" placeholder="jane@example.com"
            class="wordmark mt-2 w-full h-12 px-4 bg-[#F7F5F2] rounded-lg border border-[#2C2825]/10 focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
    </label>

    <p id="ac-error" class="wordmark mt-4 text-sm text-[#B85042] hidden"></p>
    <p id="ac-success" class="wordmark mt-4 text-sm text-[#5E7363] hidden"></p>

    <div class="mt-7 flex items-center gap-4">
        <button type="submit" id="ac-submit"
            class="wordmark relative isolate inline-flex items-center justify-center gap-2 px-6 h-11 min-w-[140px] text-[15px] text-[#F5F0EB] rounded-full ring-4 ring-transparent hover:ring-[#7A8F7E]/30 active:scale-95 transition-all duration-200 disabled:opacity-90 disabled:cursor-not-allowed before:content-[''] before:absolute before:inset-0 before:-z-10 before:rounded-full before:bg-gradient-to-b before:from-[#869C8A] before:to-[#6A7F6E] before:transition-all before:duration-200 hover:before:brightness-90">
            <svg data-spinner class="hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
            </svg>
            <span data-label>Add client</span>
        </button>
        <a href="/console/clients/" class="wordmark text-sm text-[#6B635A] hover:text-[#2C2825] transition">Cancel</a>
    </div>
</form>

<script>
    const form = document.getElementById('add-client-form');
    const firstNameInput = document.getElementById('ac-firstname');
    const surnameInput = document.getElementById('ac-surname');
    const emailInput = document.getElementById('ac-email');
    const errorEl = document.getElementById('ac-error');
    const successEl = document.getElementById('ac-success');
    const submitBtn = document.getElementById('ac-submit');
    const spinner = submitBtn.querySelector('[data-spinner]');
    const label = submitBtn.querySelector('[data-label]');

    function showError(msg) {
        successEl.classList.add('hidden');
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
    }
    function setLoading(on) {
        submitBtn.disabled = on;
        spinner.classList.toggle('hidden', !on);
        label.textContent = on ? 'Adding…' : 'Add client';
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        successEl.classList.add('hidden');

        const email = emailInput.value.trim();
        const display_name = firstNameInput.value.trim();
        const surname = surnameInput.value.trim();
        if (!email) { showError('Please enter an email address.'); emailInput.focus(); return; }

        const session = await window.consoleAuth.getSession();
        if (!session) { window.location.replace('/console/login/'); return; }

        setLoading(true);
        try {
            const res = await fetch('/.netlify/functions/add-client', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + session.access_token,
                },
                body: JSON.stringify({ email, display_name, surname }),
            });
            const data = await res.json().catch(() => ({}));

            if (!res.ok) {
                showError(data.error || 'Could not add client. Please try again.');
                setLoading(false);
                return;
            }

            // Success — briefly confirm, then return to the list.
            successEl.textContent = 'Client added. Redirecting to your clients…';
            successEl.classList.remove('hidden');
            label.textContent = 'Added';
            spinner.classList.add('hidden');
            setTimeout(() => window.location.assign('/console/clients/'), 900);
        } catch (err) {
            showError('Network error. Please check your connection and try again.');
            setLoading(false);
        }
    });
</script>
