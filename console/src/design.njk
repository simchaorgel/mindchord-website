<script>
    // The sample plots render through window.consoleUI — the same code the real
    // pages call. That is the point of this page: if the module changes, these
    // change with it, so the reference cannot quietly drift from the system.
    (function () {
        const { seriesPeak, niceCeil, renderSpark, renderAxis } = window.consoleUI;

        const sessions = [4, 9, 6, 12, 8, 15, 11, 18, 14, 21, 17, 24, 19, 26];
        const bare = [{ values: sessions, cls: 'line' }];
        document.getElementById('ref-spark').innerHTML =
            renderSpark(bare, seriesPeak(bare), 'Sample sessions trend');

        const all    = [2, 4, 5, 8, 11, 13, 16, 18, 21, 24, 26, 29, 31, 34];
        const active = [2, 3, 4, 6,  9,  8, 12, 11, 15, 17, 14, 19, 22, 20];
        const series = [
            { values: all, cls: 'line line-2' },
            { values: active, cls: 'line' },
        ];
        const max = niceCeil(seriesPeak(series));
        document.getElementById('ref-plot').innerHTML =
            renderSpark(series, max, 'Sample clients against active clients');
        renderAxis(document.getElementById('ref-axis'), max);

        // The toggle sample is live, so the page demonstrates the behaviour it
        // describes rather than just showing a static picture of it.
        document.querySelectorAll('.dir-toggle').forEach(t => {
            t.querySelectorAll('[data-dir]').forEach(b => b.addEventListener('click', () => {
                t.querySelectorAll('[data-dir]').forEach(x => x.classList.toggle('is-on', x === b));
                t.dataset.on = b.dataset.dir;
            }));
        });
    })();
</script>
