---
layout: base.njk
title: Mindchord Console
---
{# Entry point for /console/. Holds no content of its own — it reads the stored
   session and sends the visitor to the right place, so the bare URL works
   instead of 404ing. Gated pages still run their own requireSession(). #}
<main class="relative z-10 min-h-screen flex flex-col items-center justify-center gap-6 px-6">
    <div class="flex items-center gap-3">
        <img src="/console/media/favicon.png" alt="" class="h-8 md:h-9 w-auto object-contain">
        <span class="wordmark text-2xl md:text-[28px] tracking-tight">Mindchord Console</span>
    </div>

    <svg class="animate-spin w-6 h-6 text-muted" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" role="status" aria-label="Loading">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
    </svg>
</main>

<script>
    // replace(), not assign() — the splash must not sit in history, or Back
    // from the destination bounces straight through it again.
    (async function () {
        const session = await window.consoleAuth.getSession();
        window.location.replace(session ? '/console/dashboard/' : '/console/login/');
    })();
</script>
