---
layout: sidebar.njk
title: Mindchord Console — Dashboard
nav: dashboard
---
<!-- Heading row: org + welcome on the left, stat cards on the right -->
<div class="flex items-center justify-between gap-12 flex-wrap">
    <div>
        <h1 id="org-name" class="wordmark text-4xl md:text-5xl tracking-tight">
            <span class="inline-block h-9 w-48 rounded bg-[#6B635A]/10 animate-pulse align-middle"></span>
        </h1>
        <p id="welcome-line" class="wordmark mt-3 text-lg text-[#6B635A]">
            <span class="inline-block h-5 w-40 rounded bg-[#6B635A]/10 animate-pulse align-middle"></span>
        </p>
    </div>

    <!-- Stat cards — one palette accent each. -->
    <div class="flex items-center gap-4 flex-wrap">
        <div class="stat-card">
            <div class="stat-head"><span class="dot dot-sage"></span><span class="lbl">Clients</span></div>
            <div id="stat-clients" class="num">
                <span class="inline-block h-8 w-10 rounded bg-[#2C2825]/10 animate-pulse"></span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-head"><span class="dot dot-coral"></span><span class="lbl">Sessions this week</span></div>
            <div id="stat-sessions-week" class="num">
                <span class="inline-block h-8 w-10 rounded bg-[#2C2825]/10 animate-pulse"></span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-head"><span class="dot dot-gold"></span><span class="lbl">Clinicians</span></div>
            <div id="stat-clinicians" class="num">
                <span class="inline-block h-8 w-10 rounded bg-[#2C2825]/10 animate-pulse"></span>
            </div>
        </div>
    </div>
</div>

<!-- Quick actions -->
<div class="mt-8 flex flex-wrap gap-3">
    <a href="/console/add-client/"
       class="wordmark inline-flex items-center gap-2 px-5 h-11 text-[15px] text-[#F5F0EB] relative isolate rounded-full ring-4 ring-transparent hover:ring-[#7A8F7E]/30 active:scale-95 transition-all duration-200 before:content-[''] before:absolute before:inset-0 before:-z-10 before:rounded-full before:bg-gradient-to-b before:from-[#869C8A] before:to-[#6A7F6E] before:transition-all before:duration-200 hover:before:brightness-90">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6Z"/></svg>
        Add client
    </a>
    <a href="/console/organization/"
       class="wordmark inline-flex items-center gap-2 px-5 h-11 text-[15px] text-[#2C2825] rounded-full border border-[#2C2825]/15 bg-white hover:border-[#2C2825]/30 hover:bg-[#F7F5F2] active:scale-95 transition-all duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6Z"/></svg>
        Add clinician
    </a>
</div>

<!-- Sessions over time -->
<section class="mt-10 card p-6 md:p-7">
    <div class="flex items-baseline justify-between gap-4">
        <h2 class="wordmark text-2xl tracking-tight">Sessions</h2>
        <span class="wordmark text-sm text-[#6B635A]">Last 14 days</span>
    </div>

    <div id="sessions-chart" class="mt-6 h-44 flex items-end gap-1.5">
        <!-- Skeleton bars until the query resolves -->
        <div class="flex-1 rounded-t bg-[#6B635A]/10 animate-pulse" style="height:40%"></div>
        <div class="flex-1 rounded-t bg-[#6B635A]/10 animate-pulse" style="height:65%"></div>
        <div class="flex-1 rounded-t bg-[#6B635A]/10 animate-pulse" style="height:30%"></div>
        <div class="flex-1 rounded-t bg-[#6B635A]/10 animate-pulse" style="height:80%"></div>
        <div class="flex-1 rounded-t bg-[#6B635A]/10 animate-pulse" style="height:55%"></div>
        <div class="flex-1 rounded-t bg-[#6B635A]/10 animate-pulse" style="height:45%"></div>
        <div class="flex-1 rounded-t bg-[#6B635A]/10 animate-pulse" style="height:70%"></div>
    </div>

    <div id="sessions-chart-axis" class="mt-2 flex justify-between wordmark text-xs text-[#6B635A]"></div>
</section>

<script>
    // Layout already calls requireSession() — this re-await just gives us the
    // session object so we can read user.id without an extra round-trip.
    (async () => {
        const session = await window.consoleAuth.getSession();
        if (!session) return;
        await Promise.all([loadHeading(session), loadStats(), loadSessionsChart()]);
    })();

    async function loadHeading(session) {
        const sb = window.consoleAuth.sb;
        const userId = session.user?.id;

        const [orgRes, profileRes] = await Promise.all([
            sb.from('organizations').select('name').maybeSingle(),
            userId ? sb.from('profiles').select('display_name').eq('id', userId).maybeSingle() : Promise.resolve({ data: null }),
        ]);

        document.getElementById('org-name').textContent = orgRes.data?.name || '';
        const first = profileRes.data?.display_name;
        document.getElementById('welcome-line').textContent = first ? `Welcome, ${first}.` : '';
    }

    // Counts fetched in parallel with count-only queries (head: true, no row
    // data transferred). RLS scopes everything to the calling clinician's org.
    async function loadStats() {
        const sb = window.consoleAuth.sb;
        const weekStart = startOfWeekISO();

        const [clients, clinicians, sessions] = await Promise.all([
            sb.from('profiles').select('*', { count: 'exact', head: true }).eq('role', 'client'),
            sb.from('profiles').select('*', { count: 'exact', head: true }).eq('role', 'clinician'),
            sb.from('sessions').select('*', { count: 'exact', head: true }).gte('started_at', weekStart),
        ]);

        setStat('stat-clients', clients);
        setStat('stat-sessions-week', sessions);
        setStat('stat-clinicians', clinicians);
    }

    function setStat(id, result) {
        const el = document.getElementById(id);
        el.textContent = result.error ? '—' : (result.count ?? 0);
    }

    // Daily session counts for the last 14 days, rendered as flexbox bars.
    // RLS scopes rows to the calling clinician's org.
    async function loadSessionsChart() {
        const DAYS = 14;
        const chart = document.getElementById('sessions-chart');
        const axis = document.getElementById('sessions-chart-axis');

        const start = new Date();
        start.setHours(0, 0, 0, 0);
        start.setDate(start.getDate() - (DAYS - 1));

        const { data, error } = await window.consoleAuth.sb
            .from('sessions')
            .select('started_at')
            .gte('started_at', start.toISOString());

        // Bucket by day index from `start`.
        const buckets = new Array(DAYS).fill(0);
        if (!error && data) {
            for (const row of data) {
                if (!row.started_at) continue;
                const d = new Date(row.started_at);
                d.setHours(0, 0, 0, 0);
                const idx = Math.round((d - start) / 86400000);
                if (idx >= 0 && idx < DAYS) buckets[idx]++;
            }
        }

        const total = buckets.reduce((a, b) => a + b, 0);
        if (error || total === 0) {
            chart.classList.remove('items-end');
            chart.classList.add('items-center', 'justify-center');
            chart.innerHTML = `<span class="wordmark text-sm text-[#6B635A]">${error ? 'Could not load sessions.' : 'No sessions in the last 14 days.'}</span>`;
            return;
        }

        const max = Math.max(...buckets);
        chart.innerHTML = buckets.map((count, i) => {
            const d = new Date(start);
            d.setDate(start.getDate() + i);
            const label = d.toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
            const pct = count === 0 ? 2 : Math.max(6, Math.round((count / max) * 100));
            const tip = `${count} session${count === 1 ? '' : 's'} · ${label}`;
            return `<div class="flex-1 rounded-t bg-gradient-to-b from-[#869C8A] to-[#6A7F6E] hover:brightness-95 transition"
                         style="height:${pct}%" title="${tip}"></div>`;
        }).join('');

        const first = new Date(start);
        const last = new Date(start);
        last.setDate(start.getDate() + DAYS - 1);
        const fmt = (d) => d.toLocaleDateString(undefined, { day: 'numeric', month: 'short' });
        axis.innerHTML = `<span>${fmt(first)}</span><span>Today</span>`;
    }

    // ISO week starts Monday.
    function startOfWeekISO() {
        const d = new Date();
        const daysSinceMonday = (d.getDay() + 6) % 7;
        d.setHours(0, 0, 0, 0);
        d.setDate(d.getDate() - daysSinceMonday);
        return d.toISOString();
    }
</script>
