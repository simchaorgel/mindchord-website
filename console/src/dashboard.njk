---
layout: sidebar.njk
title: Mindchord Console
nav: dashboard
---
<!-- Two blocks, one column:
     1. Sessions — delivered per period, bare on the page background.
     2. Needs attention — the part that actually routes you somewhere. Every
        row links into a client record. Stretches to the bottom of the viewport
        and scrolls internally.

     Note the hidden/shown elements below use the `hidden` ATTRIBUTE, not
     Tailwind's `.hidden` class. Both `.chip` and the flex/grid utilities these
     elements need set `display` at the same specificity as `.hidden`, so which
     one wins would come down to stylesheet order. The paired `[hidden]` rules
     in the <style> block settle it deterministically. -->

<style>
    /* Masthead: welcome left, org right, same size and ink, baselines aligned.
       Both are dialled back from the .text-title token's 600 — scoped here
       (specificity 0,1,1) so it beats the weight baked into the token without
       depending on Tailwind's utility ordering.
       ml-auto rather than justify-between so the org stays right-aligned even
       when the two wrap onto separate lines on narrow viewports. */
    .masthead p, .masthead h1 { font-weight: 500; }

    /* Fill the viewport down to the bottom edge. The 5rem is main's py-10 in
       sidebar.njk — the only spacing between this column and the screen. If
       that padding changes, change this with it. */
    .dash { display: flex; flex-direction: column; min-height: calc(100dvh - 5rem); }

    /* The panel takes the leftover height; its list scrolls rather than pushing
       the card past the fold. min-height stops it collapsing on short viewports
       — below that the page scrolls instead. */
    .attn { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .attn-body { flex: 1; min-height: 7rem; overflow-y: auto; }

    .attn-empty { height: 100%; display: grid; place-items: center; }
    .attn-empty[hidden] { display: none; }
    .attn-more { display: flex; align-items: center; justify-content: center; }
    .attn-more[hidden] { display: none; }
</style>

<div class="dash">

    <header class="masthead flex items-baseline gap-4 flex-wrap">
        <p id="welcome-line" class="text-title"></p>
        <h1 id="org-name" class="text-title ml-auto">
            <span class="skeleton inline-block h-6 w-44 align-middle"></span>
        </h1>
    </header>

    <!-- Sessions over time — no card, no fill, no baseline; --spark-h sizes it.
         One label carries the whole legend: metric plus the range it covers. -->
    <section class="mt-10" style="--spark-h:150px">
        <div id="growth-label" class="text-caption font-medium text-muted">Sessions</div>
        <div id="growth-chart" class="mt-5">
            <div class="skeleton w-full rounded" style="height:var(--spark-h)"></div>
        </div>
    </section>

    <!-- Needs attention -->
    <section class="attn mt-10 card overflow-hidden">
        <div class="flex items-center justify-between gap-4 px-5 py-4 border-b border-line shrink-0">
            <span class="text-caption font-medium text-muted">Needs attention</span>
            <span id="attn-count" class="chip chip-neutral" hidden></span>
        </div>

        <div class="attn-body">
            <ul id="attn-loading" class="divide-y divide-line">
                <li class="px-5 py-3.5 flex items-center gap-3.5"><span class="skeleton h-9 w-9 rounded-full"></span><span class="skeleton h-4 w-44"></span></li>
                <li class="px-5 py-3.5 flex items-center gap-3.5"><span class="skeleton h-9 w-9 rounded-full"></span><span class="skeleton h-4 w-36"></span></li>
                <li class="px-5 py-3.5 flex items-center gap-3.5"><span class="skeleton h-9 w-9 rounded-full"></span><span class="skeleton h-4 w-52"></span></li>
            </ul>

            <div id="attn-empty" class="attn-empty text-body text-muted px-5" hidden>All clear.</div>

            <ul id="attn-list" class="hidden divide-y divide-line"></ul>
        </div>

        <a id="attn-more" href="/console/clients/"
           class="attn-more shrink-0 px-5 py-3 border-t border-line text-caption text-muted hover:text-accent transition" hidden>
        </a>
    </section>

</div>

<script>
    const {
        escapeHtml, fullName, initials, classifyClient,
        pickStep, seriesPeak, renderSpark,
    } = window.consoleUI;

    const ATTN_MAX = 8;       // rows shown before collapsing to "+N more"

    // Layout already calls requireSession() — this re-await just gives us the
    // session object so we can read user.id without an extra round-trip.
    (async () => {
        const session = await window.consoleAuth.getSession();
        if (!session) return;
        await Promise.all([loadHeading(session), loadGrowth(), loadAttention()]);
    })();

    async function loadHeading(session) {
        const sb = window.consoleAuth.sb;
        const userId = session.user?.id;

        const [orgRes, profileRes] = await Promise.all([
            sb.from('organizations').select('name').maybeSingle(),
            userId ? sb.from('profiles').select('display_name').eq('id', userId).maybeSingle() : Promise.resolve({ data: null }),
        ]);

        document.getElementById('org-name').textContent = orgRes.data?.name || '';
        const first = profileRes.data?.display_name;
        document.getElementById('welcome-line').textContent = first ? `Welcome, ${first}.` : '';
    }

    // ── Sessions over time ──────────────────────────────────────────────────
    // Sessions actually delivered per period, across the org's whole history.
    // RLS scopes rows to the calling clinician's org.
    async function loadGrowth() {
        const chart = document.getElementById('growth-chart');
        const label = document.getElementById('growth-label');

        const { data, error } = await window.consoleAuth.sb
            .from('sessions')
            .select('started_at');

        if (error) return growthMessage(chart, 'Could not load sessions.');

        const times = (data || [])
            .map(r => Date.parse(r.started_at))
            .filter(Number.isFinite)
            .sort((a, b) => a - b);

        if (times.length === 0) return growthMessage(chart, 'No sessions recorded yet.');

        // Bucket from the start of the first session's day so buckets land on
        // day boundaries rather than on whatever time that session began.
        const first = new Date(times[0]);
        first.setHours(0, 0, 0, 0);
        const t0 = first.getTime();

        const step = pickStep(Date.now() - t0);

        // Only whole buckets. The current period is still in progress, and
        // including it would draw a dip at the right edge every single time —
        // the chart would permanently look like the org is falling off.
        const n = Math.floor((Date.now() - t0) / step.ms);
        if (n < 2) return growthMessage(chart, 'Not enough history yet.');

        const counts = new Array(n).fill(0);
        for (const t of times) {
            const idx = Math.floor((t - t0) / step.ms);
            if (idx >= 0 && idx < n) counts[idx]++;
        }

        // One bare series, scaled to its own peak — no axis here, so no need to
        // round the top of the scale to tick-friendly values.
        const series = [{ values: counts, cls: 'line' }];
        chart.innerHTML = renderSpark(series, seriesPeak(series), `Sessions ${step.label.toLowerCase()}`);

        // The end date is the close of the last *whole* bucket, not today —
        // that is genuinely the range plotted.
        const fmt = (ms) => new Date(ms).toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
        label.textContent = `Sessions (${fmt(t0)} – ${fmt(t0 + n * step.ms)})`;
    }

    function growthMessage(chart, text) {
        chart.innerHTML = `<div class="grid place-items-center text-caption text-muted" style="height:var(--spark-h)">${text}</div>`;
    }

    // ── Needs attention ─────────────────────────────────────────────────────
    async function loadAttention() {
        const sb = window.consoleAuth.sb;
        const loading = document.getElementById('attn-loading');
        const empty = document.getElementById('attn-empty');
        const list = document.getElementById('attn-list');
        const countEl = document.getElementById('attn-count');
        const more = document.getElementById('attn-more');

        const { data: clients, error } = await sb
            .from('profiles')
            .select('id, display_name, surname, licence_issued_at, licence_expires_at')
            .eq('role', 'client');

        loading.classList.add('hidden');

        if (error || !clients) {
            empty.textContent = 'Could not load clients.';
            empty.hidden = false;
            return;
        }
        if (clients.length === 0) {
            empty.textContent = 'No clients yet.';
            empty.hidden = false;
            return;
        }

        const ids = clients.map(c => c.id);
        const [protoRes, sessRes] = await Promise.all([
            sb.from('assigned_sessions').select('client_id').in('client_id', ids).is('archived_at', null),
            sb.from('sessions').select('user_id, ended_at').in('user_id', ids).not('ended_at', 'is', null),
        ]);

        const hasProtocol = new Set((protoRes.data || []).map(r => r.client_id));
        const lastSession = new Map();
        for (const row of sessRes.data || []) {
            const d = new Date(row.ended_at);
            const cur = lastSession.get(row.user_id);
            if (!cur || d > cur) lastSession.set(row.user_id, d);
        }

        const items = clients
            .map(c => {
                const flag = classifyClient(c, hasProtocol.has(c.id), lastSession.get(c.id));
                return flag && { ...flag, client: c };
            })
            .filter(Boolean)
            .sort((a, b) => a.rank - b.rank
                || a.urgency - b.urgency
                || fullName(a.client).localeCompare(fullName(b.client)));

        if (items.length === 0) {
            empty.hidden = false;
            return;
        }

        countEl.textContent = items.length;
        countEl.hidden = false;

        list.innerHTML = items.slice(0, ATTN_MAX).map(item => `
            <li>
                <a href="/console/client/?id=${encodeURIComponent(item.client.id)}"
                   class="flex items-center justify-between gap-4 px-5 py-3.5 group hover:bg-surface-2 transition">
                    <div class="flex items-center gap-3.5 min-w-0">
                        <span class="w-9 h-9 rounded-full bg-accent-weak text-accent-ink grid place-items-center text-caption font-semibold shrink-0">${escapeHtml(initials(item.client))}</span>
                        <div class="min-w-0">
                            <div class="text-body font-medium text-ink group-hover:text-accent transition truncate">${escapeHtml(fullName(item.client))}</div>
                            <div class="text-caption text-muted truncate">${escapeHtml(item.detail)}</div>
                        </div>
                    </div>
                    <span class="chip ${item.chip} shrink-0">${escapeHtml(item.label)}</span>
                </a>
            </li>`).join('');
        list.classList.remove('hidden');

        if (items.length > ATTN_MAX) {
            more.textContent = `${items.length - ATTN_MAX} more · view all clients`;
            more.hidden = false;
        }
    }
</script>
