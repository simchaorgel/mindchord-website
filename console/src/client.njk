---
layout: sidebar.njk
title: Mindchord Console | Client
nav: clients
---
<style>
    /* Band chip — small inline pill with a coloured dot for direction. */
    .band-chip {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 3px 9px; border-radius: 999px;
        background: var(--surface-2); font-size: 12.5px; color: var(--ink);
    }
    .band-chip .dot { width: 6px; height: 6px; border-radius: 999px; background: var(--text-muted); }
    .band-chip.reward .dot { background: var(--ok); }
    .band-chip.punish .dot { background: var(--danger); }
</style>

<!-- Breadcrumb back to the client list -->
<a href="/console/clients/" class="btn-link text-caption">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
        <path d="M14.7 17.7a1 1 0 0 1-1.4 0L8 12.4a.5.5 0 0 1 0-.8l5.3-5.3a1 1 0 1 1 1.4 1.42L10.82 12l3.88 3.88a1 1 0 0 1 0 1.42Z"/>
    </svg>
    All clients
</a>

<div class="mt-4 flex items-start justify-between gap-6">
    <div class="min-w-0">
        <h1 id="client-name" class="text-display">
            <span class="skeleton inline-block h-10 w-72 align-middle"></span>
        </h1>
        <p id="client-sub" class="text-body text-muted mt-2"></p>
    </div>

    <!-- Client-level actions. Hidden until the client loads (no actions on a
         missing/unselected client). -->
    <div id="client-actions" class="menu hidden shrink-0">
        <button id="client-menu-btn" type="button" class="btn btn-secondary btn-icon" aria-haspopup="true" aria-expanded="false" aria-label="Client actions">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
        </button>
        <div id="client-menu" class="menu-panel" hidden role="menu">
            <button type="button" class="menu-item" data-client-action="edit" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                Edit details
            </button>
            <button type="button" class="menu-item" data-client-action="licence" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M9 15h6"/><path d="M9 11h3"/></svg>
                Create offline licence
            </button>
            <button type="button" class="menu-item" data-client-action="block" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/></svg>
                Block access
            </button>
            <div class="menu-sep"></div>
            <button type="button" class="menu-item danger" data-client-action="remove" role="menuitem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M6 6v14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V6"/></svg>
                Remove client
            </button>
        </div>
    </div>
</div>

<!-- ── Protocols ───────────────────────────────────────────── -->
<section class="mt-10">
    <div class="flex items-end justify-between gap-6">
        <h2 class="text-section">Protocols</h2>
        <button id="add-protocol-btn" type="button" class="btn btn-primary btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6Z"/>
            </svg>
            New protocol
        </button>
    </div>

    <div id="protocols-loading" class="mt-5 flex flex-col gap-4">
        <div class="skeleton h-32 rounded-card"></div>
        <div class="skeleton h-32 rounded-card"></div>
    </div>

    <div id="protocols-empty" class="hidden mt-5 rounded-card border border-dashed border-line-strong p-10 text-center text-muted text-body">
        No protocols assigned yet.
    </div>

    <div id="protocols-grid" class="hidden mt-5 flex flex-col gap-4"></div>
</section>

<!-- ── Sessions ────────────────────────────────────────────── -->
<section class="mt-12">
    <h2 class="text-section">Sessions</h2>

    <div class="mt-4 card overflow-hidden">
        <div id="sessions-loading" class="divide-y divide-line">
            <div class="px-5 py-4 flex items-center gap-6"><span class="skeleton h-4 w-40"></span><span class="skeleton h-3 w-24"></span></div>
            <div class="px-5 py-4 flex items-center gap-6"><span class="skeleton h-4 w-36"></span><span class="skeleton h-3 w-28"></span></div>
            <div class="px-5 py-4 flex items-center gap-6"><span class="skeleton h-4 w-44"></span><span class="skeleton h-3 w-20"></span></div>
        </div>

        <div id="sessions-empty" class="hidden py-12 text-center text-muted text-body">No sessions yet.</div>

        <table id="sessions-table" class="table hidden">
            <thead>
                <tr><th>Session</th><th>Date</th><th class="text-right">Duration</th><th class="text-right">Above</th><th class="text-right">Best streak</th></tr>
            </thead>
            <tbody id="sessions-list"></tbody>
        </table>

        <!-- Pagination — hidden until there's more than one page of sessions. -->
        <div id="sessions-pager" class="hidden items-center justify-between gap-4 px-5 py-3 border-t border-line">
            <span id="sessions-range" class="text-caption text-muted tnum"></span>
            <div class="flex items-center gap-2">
                <button id="sessions-prev" type="button" class="btn btn-secondary btn-sm">Previous</button>
                <button id="sessions-next" type="button" class="btn btn-secondary btn-sm">Next</button>
            </div>
        </div>
    </div>
</section>

<!-- Block access confirmation -->
<div id="block-modal" class="modal" hidden data-action="block" role="dialog" aria-modal="true" aria-labelledby="block-title">
    <div class="scrim" data-close></div>
    <div class="dialog">
        <h2 id="block-title" class="text-section">Block access?</h2>
        <p class="text-body text-muted mt-2">This client will be signed out and unable to access the Mindchord app until you unblock them. Their data and history are kept.</p>
        <div class="mt-6 flex items-center justify-end gap-3">
            <button type="button" class="btn btn-secondary" data-close>Cancel</button>
            <button type="button" class="btn btn-danger" data-confirm>Block access</button>
        </div>
    </div>
</div>

<!-- Remove client confirmation -->
<div id="remove-modal" class="modal" hidden data-action="remove" role="dialog" aria-modal="true" aria-labelledby="remove-title">
    <div class="scrim" data-close></div>
    <div class="dialog">
        <h2 id="remove-title" class="text-section">Remove client?</h2>
        <p class="text-body text-muted mt-2">This permanently removes the client and their account. This action cannot be undone.</p>
        <div class="mt-6 flex items-center justify-end gap-3">
            <button type="button" class="btn btn-secondary" data-close>Cancel</button>
            <button type="button" class="btn btn-danger" data-confirm>Remove client</button>
        </div>
    </div>
</div>

<!-- Edit client details -->
<div id="edit-client-modal" class="modal modal-drawer" hidden role="dialog" aria-modal="true" aria-labelledby="ecm-title">
    <div class="scrim" data-close></div>
    <form id="edit-client-form" class="dialog drawer dialog-framed" novalidate>
        <div class="dialog-header flex items-center justify-between gap-4">
            <h2 id="ecm-title" class="text-section">Edit details</h2>
            <button type="button" class="icon-close" data-close aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>
        <div class="dialog-body">
            <p class="text-body text-muted">The client can see these details in the Mindchord app.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5">
                <label class="field block">
                    <span class="label">First name</span>
                    <input id="ec-firstname" class="input" type="text" autocomplete="given-name" placeholder="Jane">
                </label>
                <label class="field block">
                    <span class="label">Surname</span>
                    <input id="ec-surname" class="input" type="text" autocomplete="family-name" placeholder="Doe">
                </label>
            </div>

            <!-- Machine code — needed before an offline licence can be issued.
                 Kept here rather than in the licence dialog so it's part of the
                 client's record: it only has to be collected once, and every
                 later renewal reads it from here. -->
            <div class="mt-6 pt-6 border-t border-line">
                <label class="field block">
                    <span class="label">Machine code <span class="text-muted font-normal">(optional)</span></span>
                    <input id="ec-machine-code" class="input tnum max-w-[260px]" type="text" spellcheck="false"
                           autocapitalize="characters" autocomplete="off" placeholder="V57N-3SQ0-N7FW" aria-describedby="ec-mc-help">
                </label>
                <p id="ec-mc-help" class="pf-help">
                    Only needed for offline use. The client finds it on the app’s licence screen, where a copy button puts it on their clipboard.
                </p>
                <p id="ec-mc-error" class="text-caption text-danger mt-2 hidden"></p>
            </div>

            <p id="ec-error" class="text-caption text-danger mt-4 hidden"></p>
        </div>
        <div class="dialog-footer">
            <button type="button" class="btn btn-secondary" data-close>Cancel</button>
            <button type="submit" id="ec-save" class="btn btn-primary min-w-[120px]">
                <svg data-spinner class="hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
                </svg>
                <span data-label>Save changes</span>
            </button>
        </div>
    </form>
</div>

<!-- ── Offline licence ─────────────────────────────────────────────────────
     A signed .mind file carrying the client's identity, their entitlement, and
     their active protocols — everything the desktop app would otherwise fetch
     from Supabase. Issuing a new one is how you both renew a subscription and
     push protocol changes; it's the same artifact either way.

     Signing happens server-side (netlify/functions/mint-licence.js). The private
     key must never reach the browser. -->
<div id="licence-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="lc-title">
    <div class="scrim" data-close></div>
    <div class="dialog dialog-lg">
        <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
                <h2 id="lc-title" class="text-section">Create offline licence</h2>
                <p class="text-caption text-muted mt-1">Lets this client run Mindchord without an internet connection.</p>
            </div>
            <button type="button" class="icon-close mt-1" data-close aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>

        <!-- Blocked: no machine code on record, so there's nothing to bind to. -->
        <div id="lc-blocked" class="mt-6 hidden">
            <p class="text-body">
                This client has no machine code on record. A licence is locked to one computer, so
                the code has to be added before one can be issued.
            </p>
            <p class="text-body text-muted mt-3">
                Ask the client to open Mindchord and copy the code from the licence screen, then add it
                under Edit details.
            </p>
            <div class="mt-6 flex items-center justify-end gap-3">
                <button type="button" class="btn btn-secondary" data-close>Cancel</button>
                <button type="button" id="lc-goto-edit" class="btn btn-primary">Edit details</button>
            </div>
        </div>

        <!-- Ready to issue. -->
        <div id="lc-ready" class="mt-6 hidden">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div>
                    <div class="meta-label">Machine</div>
                    <div id="lc-machine" class="text-caption text-ink tnum mt-2"></div>
                </div>
                <div>
                    <div class="meta-label">Protocols</div>
                    <div id="lc-protocols" class="text-caption text-ink mt-2"></div>
                </div>
                <div>
                    <div class="meta-label">Valid until</div>
                    <div id="lc-expiry" class="text-caption text-ink mt-2"></div>
                </div>
            </div>

            <!-- Current licence state, when one has been issued before. -->
            <p id="lc-existing" class="text-caption text-muted mt-5 hidden"></p>

            <!-- Shown when a protocol was added or versioned after the last
                 licence went out — i.e. the client is still running the old set. -->
            <div id="lc-stale" class="mt-5 hidden rounded-card border border-line-strong bg-surface-2 p-4">
                <p class="text-caption text-ink">
                    Protocols have changed since the last licence was issued. The client is still running the
                    older set until they import a new file.
                </p>
            </div>

            <p id="lc-error" class="text-caption text-danger mt-5 hidden"></p>

            <div class="mt-6 flex items-center justify-end gap-3">
                <button type="button" class="btn btn-secondary" data-close>Cancel</button>
                <button type="button" id="lc-create" class="btn btn-primary min-w-[150px]">
                    <svg data-spinner class="hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
                    </svg>
                    <span data-label>Create licence</span>
                </button>
            </div>
        </div>

        <!-- Issued. -->
        <div id="lc-done" class="mt-6 hidden">
            <p class="text-body">The licence file has been downloaded. Send it to the client by email, USB stick or file share — they import it from the app’s licence screen.</p>
            <p id="lc-done-detail" class="text-caption text-muted mt-3"></p>
            <div class="mt-6 flex items-center justify-end gap-3">
                <button type="button" class="btn btn-primary" data-close>Done</button>
            </div>
        </div>
    </div>
</div>

<!-- ── Protocol editor (New / Edit) ────────────────────────────────────────
     Channels are Muse headband sensors (AF7/AF8/TP9/TP10/AUX); aux_position
     is the 10-20 site the loose AUX electrode sits at, shown only when the
     feedback channel is AUX. Bands are 1–2 frequency windows. -->
<div id="protocol-modal" class="modal modal-drawer" hidden role="dialog" aria-modal="true" aria-labelledby="protocol-title">
    <div class="scrim" data-close></div>
    <form id="protocol-form" class="dialog drawer dialog-framed" novalidate>
        <!-- Sticky header -->
        <div class="dialog-header flex items-center justify-between gap-4">
            <h2 id="protocol-title" class="text-section">New protocol</h2>
            <button type="button" class="icon-close" data-close aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>

        <!-- Scrolling body — a sequence of hairline-divided sections. -->
        <div class="dialog-body">
            <!-- Details -->
            <section class="pf-section">
                <h3 class="meta-label">Details</h3>
                <div class="mt-3 space-y-3">
                    <label class="field block">
                        <span class="label">Name</span>
                        <input id="pf-name" class="input input-grotesk" type="text" placeholder="e.g. Alpha uptraining" required>
                    </label>

                    <label class="field block">
                        <span class="label">Description</span>
                        <textarea id="pf-description" class="input input-grotesk" data-autogrow placeholder="Notes for this protocol…" required rows="2"></textarea>
                    </label>
                </div>
            </section>

            <!-- Bands — an aligned mini-table; labels live in the column header. -->
            <section class="pf-section">
                <div class="flex items-center justify-between">
                    <h3 class="meta-label">Bands</h3>
                    <button id="pf-add-band" type="button" class="btn btn-secondary btn-sm text-accent">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6Z"/></svg>
                        Add band
                    </button>
                </div>
                <p class="pf-help">Reward or inhibit one or two frequency windows. Leave Z blank to default to 0.</p>
                <div class="pf-bands-panel">
                    <div class="pf-band-head">
                        <span>Low Hz</span>
                        <span>High Hz</span>
                        <span>Direction</span>
                        <span>Z</span>
                        <span></span>
                    </div>
                    <div id="pf-bands"></div>
                </div>
            </section>

            <!-- Channels -->
            <section class="pf-section">
                <h3 class="meta-label">Channels</h3>
                <p class="pf-help">The feedback channel drives training; reference channels are subtracted as noise.</p>
                <div class="field block">
                    <span class="label">Feedback channel</span>
                    <div id="pf-feedback" class="mt-2 flex flex-wrap gap-2"></div>
                </div>
                <label id="pf-aux-field" class="field block hidden mt-4">
                    <span class="label">AUX position</span>
                    <select id="pf-aux" class="input max-w-[240px]"></select>
                </label>
                <div class="field block mt-4">
                    <span class="label">Reference channels <span class="text-muted font-normal">(optional)</span></span>
                    <div id="pf-reference" class="mt-2 flex flex-wrap gap-2"></div>
                </div>
            </section>

            <!-- Duration -->
            <section class="pf-section">
                <h3 class="meta-label">Duration</h3>
                <p class="pf-help">Calibration is the quiet baseline recorded before training starts. Leave blank to use the app’s default.</p>
                <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-3">
                    <div class="flex items-center gap-2.5">
                        <input id="pf-duration" class="input tnum w-24" type="number" min="1" step="1" placeholder="3">
                        <span class="text-body text-muted">minutes</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <input id="pf-calibration" class="input tnum w-24" type="number" min="0" max="600" step="5" placeholder="—" aria-label="Calibration (seconds)">
                        <span class="text-body text-muted">seconds calibration</span>
                    </div>
                </div>
            </section>
        </div>

        <!-- Sticky footer -->
        <div class="dialog-footer">
            <p id="pf-error" class="text-caption text-danger mr-auto hidden"></p>
            <button type="button" class="btn btn-secondary" data-close>Cancel</button>
            <button type="submit" id="pf-save" class="btn btn-primary min-w-[130px]">
                <svg data-spinner class="hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
                </svg>
                <span data-label>Save changes</span>
            </button>
        </div>
    </form>
</div>

<!-- Remove protocol confirmation -->
<div id="remove-protocol-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="rp-title">
    <div class="scrim" data-close></div>
    <div class="dialog">
        <h2 id="rp-title" class="text-section">Remove protocol?</h2>
        <p id="rp-body" class="text-body text-muted mt-2"></p>
        <p id="rp-error" class="text-caption text-danger mt-3 hidden"></p>
        <div class="mt-6 flex items-center justify-end gap-3">
            <button type="button" class="btn btn-secondary" data-close>Cancel</button>
            <button type="button" id="rp-confirm" class="btn btn-danger min-w-[120px]">
                <svg data-spinner class="hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
                </svg>
                <span data-label>Remove</span>
            </button>
        </div>
    </div>
</div>

<!-- Session protocol view (read-only) — shows the exact, frozen settings the
     session ran against, which may be an archived protocol version. -->
<div id="session-protocol-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="spm-title">
    <div class="scrim" data-close></div>
    <div class="dialog dialog-lg">
        <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
                <h2 id="spm-title" class="text-section">Protocol</h2>
                <p id="spm-when" class="text-caption text-muted mt-1"></p>
            </div>
            <button type="button" class="icon-close mt-1" data-close aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
        </div>
        <div id="spm-body" class="mt-5"></div>
    </div>
</div>

<script>
    // Muse channels + the 10-20 sites where a loose AUX electrode can sit.
    const FEEDBACK_CHANNELS = ['AF7', 'AF8', 'TP9', 'TP10', 'AUX'];
    const AUX_POSITIONS = ['Fp1','Fp2','F7','F3','Fz','F4','F8','T3','C3','Cz','C4','T4','T5','P3','Pz','P4','T6','O1','O2'];

    // Highest frequency a band may reach. Above this the desktop app has no
    // defined behaviour, and a licence carrying it would be signed and
    // un-recallable — so the editor refuses it and so does the mint endpoint.
    const MAX_BAND_HZ = 45;

    // The canonical value when a clinician leaves Z blank. This number is also
    // hard-coded in netlify/functions/mint-licence.js and in the desktop app —
    // it must be the same in all three, or a protocol means different things
    // online and offline.
    const DEFAULT_THRESHOLD_Z = 0;
</script>
<script>
    // ── Machine codes ───────────────────────────────────────────────────────
    // Identifies one computer; a licence is locked to it. Crockford Base32,
    // which drops I, L, O and U because those are the characters people mangle
    // when reading a code aloud. 12 characters, the last a position-weighted
    // checksum over the first 11 — so a transposition is caught, not just a
    // wrong character.
    //
    // Also implemented in netlify/functions/mint-licence.js. That copy is the
    // gate; this one is here so a clinician finds a typo while the client is
    // still on the phone. A wrong code produces a licence that fails silently
    // on the target machine, which is near-impossible to diagnose remotely.
    const CROCKFORD = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';

    // Stored normalised — the app compares normalised forms, so case, hyphens
    // and I/L/O confusion don't matter, but a wrong character does.
    function normaliseMachineCode(code) {
        return String(code || '').toUpperCase().replace(/[-\s]/g, '')
            .replace(/I/g, '1').replace(/L/g, '1').replace(/O/g, '0');
    }

    function machineCodeCheckChar(body) {
        let total = 0;
        for (let i = 0; i < body.length; i++) total += (i + 1) * CROCKFORD.indexOf(body[i]);
        return CROCKFORD[total % 32];
    }

    function isValidMachineCode(code) {
        const c = normaliseMachineCode(code);
        if (c.length !== 12) return false;
        if ([...c].some(ch => !CROCKFORD.includes(ch))) return false;
        return machineCodeCheckChar(c.slice(0, 11)) === c[11];
    }

    // Display form: three groups of four, as the app shows it.
    function formatMachineCode(code) {
        const c = normaliseMachineCode(code);
        return c.length === 12 ? `${c.slice(0, 4)}-${c.slice(4, 8)}-${c.slice(8)}` : c;
    }
</script>
<script>
    const clientId = new URLSearchParams(location.search).get('id');

    (async () => {
        if (!clientId) {
            document.getElementById('client-name').textContent = 'No client selected';
            document.getElementById('protocols-loading').classList.add('hidden');
            document.getElementById('protocols-empty').classList.remove('hidden');
            document.getElementById('sessions-loading').classList.add('hidden');
            document.getElementById('sessions-empty').classList.remove('hidden');
            return;
        }
        await Promise.all([loadClient(), loadProtocols(), loadSessions()]);
    })();

    async function loadClient() {
        const [profileRes, countRes] = await Promise.all([
            window.consoleAuth.sb
                .from('profiles')
                .select('display_name, surname, role, machine_code, licence_issued_at, licence_expires_at')
                .eq('id', clientId)
                .maybeSingle(),
            window.consoleAuth.sb
                .from('sessions')
                .select('id', { count: 'exact', head: true })
                .eq('user_id', clientId)
                .not('ended_at', 'is', null),
        ]);

        const heading = document.getElementById('client-name');
        const sub = document.getElementById('client-sub');
        if (profileRes.error || !profileRes.data) {
            heading.textContent = 'Client not found';
            return;
        }
        clientProfile = profileRes.data;
        clientSessionCount = countRes.count ?? 0;
        renderClientHeader();

        // Client loaded successfully — surface the actions menu.
        document.getElementById('client-actions').classList.remove('hidden');
    }

    // Current client profile + session count, kept so the edit form can prefill
    // and the header can re-render after an edit without a full reload.
    let clientProfile = null;
    let clientSessionCount = 0;

    function renderClientHeader() {
        document.getElementById('client-name').textContent = fullName(clientProfile);
        const parts = [];
        if (clientProfile.role) parts.push(clientProfile.role.charAt(0).toUpperCase() + clientProfile.role.slice(1));
        parts.push(`${clientSessionCount} session${clientSessionCount === 1 ? '' : 's'} completed`);
        // Only clients set up for offline use have a licence, so this stays out
        // of the way for everyone else.
        if (clientProfile.licence_expires_at) {
            const exp = new Date(clientProfile.licence_expires_at);
            parts.push(exp < new Date()
                ? `Licence expired ${formatDate(clientProfile.licence_expires_at)}`
                : `Licence until ${formatDate(clientProfile.licence_expires_at)}`);
        }
        document.getElementById('client-sub').textContent = parts.join(' · ');
    }

    // ── Client actions menu ─────────────────────────────────────────────
    // 'Edit' is wired below. Block / Remove still open their confirm modals
    // with stubbed confirm handlers until those backends exist.
    (function () {
        const wrap = document.getElementById('client-actions');
        const btn = document.getElementById('client-menu-btn');
        const panel = document.getElementById('client-menu');

        const open = () => { panel.hidden = false; btn.setAttribute('aria-expanded', 'true'); };
        const close = () => { panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); };
        const toggle = () => (panel.hidden ? open() : close());

        btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
        document.addEventListener('click', (e) => { if (!wrap.contains(e.target)) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

        panel.querySelectorAll('[data-client-action]').forEach(item => {
            item.addEventListener('click', () => {
                const action = item.dataset.clientAction;
                close();
                if (action === 'edit') openEditClient();
                else if (action === 'licence') openLicenceModal();
                else if (action === 'block') openModal('block-modal');
                else if (action === 'remove') openModal('remove-modal');
            });
        });
    })();

    // ── Edit client details (display_name / surname / machine_code) ─────
    // Client-side UPDATE on profiles, gated by RLS. Refreshes the header in
    // place on success — no full reload needed.
    function openEditClient() {
        if (!clientProfile) return;
        document.getElementById('ec-error').classList.add('hidden');
        document.getElementById('ec-mc-error').classList.add('hidden');
        document.getElementById('ec-firstname').value = clientProfile.display_name || '';
        document.getElementById('ec-surname').value = clientProfile.surname || '';
        document.getElementById('ec-machine-code').value = formatMachineCode(clientProfile.machine_code || '');
        document.getElementById('edit-client-modal').hidden = false;
        document.getElementById('ec-firstname').focus();
    }
    (function () {
        const modal = document.getElementById('edit-client-modal');
        const form = document.getElementById('edit-client-form');
        const errorEl = document.getElementById('ec-error');
        const mcInput = document.getElementById('ec-machine-code');
        const mcError = document.getElementById('ec-mc-error');
        const saveBtn = document.getElementById('ec-save');
        const spinner = saveBtn.querySelector('[data-spinner]');

        const close = () => { modal.hidden = true; };
        modal.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', close));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });

        // Tidy the code into its display form once they've finished typing —
        // doing it on every keystroke fights the cursor.
        mcInput.addEventListener('blur', () => {
            if (mcInput.value.trim()) mcInput.value = formatMachineCode(mcInput.value);
        });
        mcInput.addEventListener('input', () => mcError.classList.add('hidden'));

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorEl.classList.add('hidden');
            mcError.classList.add('hidden');
            const display_name = document.getElementById('ec-firstname').value.trim() || null;
            const surname = document.getElementById('ec-surname').value.trim() || null;

            // Blank clears the code; anything else has to pass the checksum
            // before it's stored, because the failure it causes surfaces on the
            // client's machine days later rather than here.
            const rawCode = mcInput.value.trim();
            let machine_code = null;
            if (rawCode) {
                if (!isValidMachineCode(rawCode)) {
                    mcError.textContent = 'That machine code isn’t valid. Check it against the client’s licence screen — it should be 12 characters.';
                    mcError.classList.remove('hidden');
                    mcInput.focus();
                    return;
                }
                machine_code = normaliseMachineCode(rawCode);
            }

            saveBtn.disabled = true; spinner.classList.remove('hidden');
            try {
                const { error } = await window.consoleAuth.sb
                    .from('profiles').update({ display_name, surname, machine_code }).eq('id', clientId);
                if (error) throw error;
                clientProfile = { ...clientProfile, display_name, surname, machine_code };
                renderClientHeader();
                close();
            } catch (err) {
                errorEl.textContent = err.message || 'Could not save changes. Please try again.';
                errorEl.classList.remove('hidden');
            } finally {
                saveBtn.disabled = false; spinner.classList.add('hidden');
            }
        });
    })();

    // ── Offline licence ─────────────────────────────────────────────────
    // The console never signs anything itself — it posts to mint-licence,
    // which holds the private key and does the authorization checks, and gets
    // back finished file text to hand the clinician as a download.
    function openLicenceModal() {
        if (!clientProfile) return;
        const modal = document.getElementById('licence-modal');
        const blocked = document.getElementById('lc-blocked');
        const ready = document.getElementById('lc-ready');
        const done = document.getElementById('lc-done');
        const hasCode = !!clientProfile.machine_code;

        document.getElementById('lc-error').classList.add('hidden');
        done.classList.add('hidden');
        blocked.classList.toggle('hidden', hasCode);
        ready.classList.toggle('hidden', !hasCode);

        if (hasCode) {
            document.getElementById('lc-machine').textContent = formatMachineCode(clientProfile.machine_code);

            const count = protocolsById.size;
            document.getElementById('lc-protocols').textContent =
                !protocolsLoaded ? '…' : count === 0 ? 'None — add one first' : `${count} active`;
            // A licence with no protocols is unusable; the mint endpoint refuses
            // one too. Only disable once we actually know the count.
            document.getElementById('lc-create').disabled = protocolsLoaded && count === 0;

            // Preview the expiry the server will stamp. Kept in step with
            // addOneMonthUTC() in mint-licence.js; the server's value is
            // authoritative and gets shown once the file is issued.
            const preview = new Date();
            const day = preview.getUTCDate();
            preview.setUTCMonth(preview.getUTCMonth() + 1);
            if (preview.getUTCDate() !== day) preview.setUTCDate(0);
            document.getElementById('lc-expiry').textContent = formatDate(preview.toISOString());

            const existing = document.getElementById('lc-existing');
            if (clientProfile.licence_issued_at) {
                const expired = clientProfile.licence_expires_at && new Date(clientProfile.licence_expires_at) < new Date();
                existing.textContent = `A licence was issued on ${formatDate(clientProfile.licence_issued_at)} and `
                    + `${expired ? 'expired' : 'runs until'} ${formatDate(clientProfile.licence_expires_at)}. `
                    + 'Creating a new one replaces it.';
                existing.classList.remove('hidden');
            } else {
                existing.classList.add('hidden');
            }

            document.getElementById('lc-stale').classList.toggle('hidden', !protocolsChangedSinceLicence());
        }

        modal.hidden = false;
        modal.querySelector(hasCode ? '#lc-create' : '#lc-goto-edit').focus();
    }

    // True when an active protocol was created after the last licence went out,
    // which means the client is running a stale set until they import a new file.
    //
    // Catches new and newly-versioned protocols — the changes that alter how a
    // session runs. It does NOT catch a protocol archived since issue: the
    // client keeps running that one until the licence expires, and there's no
    // way to recall it.
    function protocolsChangedSinceLicence() {
        const issued = clientProfile?.licence_issued_at;
        if (!issued) return false;
        const issuedAt = new Date(issued);
        return [...protocolsById.values()].some(p => p.created_at && new Date(p.created_at) > issuedAt);
    }

    (function () {
        const modal = document.getElementById('licence-modal');
        const createBtn = document.getElementById('lc-create');
        const spinner = createBtn.querySelector('[data-spinner]');
        const errorEl = document.getElementById('lc-error');

        const close = () => { modal.hidden = true; };
        modal.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', close));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });

        // Blocked state → straight into the field they need to fill.
        document.getElementById('lc-goto-edit').addEventListener('click', () => {
            close();
            openEditClient();
            document.getElementById('ec-machine-code').focus();
        });

        createBtn.addEventListener('click', async () => {
            errorEl.classList.add('hidden');
            const session = await window.consoleAuth.getSession();
            if (!session) { window.location.replace('/console/login/'); return; }

            createBtn.disabled = true; spinner.classList.remove('hidden');
            try {
                const res = await fetch('/.netlify/functions/mint-licence', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + session.access_token,
                    },
                    body: JSON.stringify({ client_id: clientId }),
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) {
                    errorEl.textContent = data.error || 'Could not create the licence. Please try again.';
                    errorEl.classList.remove('hidden');
                    return;
                }

                downloadLicence(data.filename, data.contents);

                // Keep the page in step with what the server recorded — the
                // header, and the protocol editor's versioning gate, both read
                // these.
                clientProfile = {
                    ...clientProfile,
                    licence_issued_at: data.issued_at,
                    licence_expires_at: data.expires_at,
                };
                renderClientHeader();

                document.getElementById('lc-done-detail').textContent =
                    `${data.filename} · ${data.protocol_count} protocol${data.protocol_count === 1 ? '' : 's'} · valid until ${formatDate(data.expires_at)}`;
                document.getElementById('lc-ready').classList.add('hidden');
                document.getElementById('lc-done').classList.remove('hidden');
                modal.querySelector('#lc-done [data-close]').focus();
            } catch (err) {
                errorEl.textContent = 'Network error. Please check your connection and try again.';
                errorEl.classList.remove('hidden');
            } finally {
                createBtn.disabled = false; spinner.classList.add('hidden');
            }
        });

        function downloadLicence(filename, contents) {
            const url = URL.createObjectURL(new Blob([contents], { type: 'application/json' }));
            const a = document.createElement('a');
            a.href = url;
            a.download = filename || 'licence.mind';
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }
    })();

    // ── Confirmation modals (Block / Remove) ────────────────────────────
    // The confirm handlers are stubbed until the backends exist; the modal
    // open/close + focus behaviour is fully wired.
    function openModal(id) {
        const m = document.getElementById(id);
        m.hidden = false;
        m.querySelector('[data-confirm]').focus();
    }
    function closeModal(m) { m.hidden = true; }

    document.querySelectorAll('#block-modal, #remove-modal').forEach(m => {
        m.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', () => closeModal(m)));
        m.querySelector('[data-confirm]').addEventListener('click', () => {
            const action = m.dataset.action;
            closeModal(m);
            // TODO: wire to backend. Placeholder until those flows exist.
            console.log('confirmed:', action, clientId);
        });
    });
    document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('#block-modal, #remove-modal').forEach(m => { if (!m.hidden) closeModal(m); });
    });

    // Protocols == active rows in `assigned_sessions` for this client.
    // RLS already scopes by org; we just filter the one client + skip
    // archived rows (soft-deleted prescriptions are kept for history).
    async function loadProtocols() {
        const [protocolsRes, countsMap] = await Promise.all([
            window.consoleAuth.sb
                .from('assigned_sessions')
                .select('id, name, description, bands, channels, duration_seconds, calibration_seconds, created_at')
                .eq('client_id', clientId)
                .is('archived_at', null)
                .order('created_at', { ascending: false }),
            fetchSessionCountsByProtocol(),
        ]);
        const { data, error } = protocolsRes;

        const loading = document.getElementById('protocols-loading');
        const empty = document.getElementById('protocols-empty');
        const grid = document.getElementById('protocols-grid');

        loading.classList.add('hidden');

        if (error || !data) {
            empty.textContent = 'Could not load protocols.';
            empty.classList.remove('hidden');
            return;
        }
        // Cache so the editor/remove flows can read a protocol's current
        // values and session count without re-querying.
        protocolsById = new Map(data.map(p => [p.id, p]));
        protocolCounts = countsMap;

        if (data.length === 0) {
            grid.classList.add('hidden');
            empty.classList.remove('hidden');
            protocolsLoaded = true;
            return;
        }

        empty.classList.add('hidden');
        grid.innerHTML = data.map(p => renderProtocol(p, countsMap.get(p.id) || 0)).join('');
        grid.classList.remove('hidden');
        protocolsLoaded = true;
    }

    // loadClient() reveals the actions menu as soon as the profile arrives,
    // which can be before the protocols land — so the licence dialog has to know
    // whether an empty cache means "none" or "not yet".
    let protocolsLoaded = false;

    // In-memory caches, populated by loadProtocols().
    let protocolsById = new Map();
    let protocolCounts = new Map();

    // A protocol is "in use" once the client could already have run it: either a
    // completed session exists, or it went out in an offline licence.
    //
    // Editing the parameters of an in-use protocol has to create a new version
    // rather than rewrite the old row, so past sessions keep the settings they
    // actually ran under.
    //
    // The licence half is load-bearing: offline clients write no `sessions` rows
    // at all — their logs stay on their machine until the export feature lands.
    // Going on session count alone, every edit for an offline client would look
    // like an edit to a never-used protocol and silently rewrite parameters they
    // are still training against.
    function isProtocolInUse(protocol) {
        if ((protocolCounts.get(protocol.id) || 0) > 0) return true;
        const issued = clientProfile?.licence_issued_at;
        return !!(issued && protocol.created_at
            && new Date(protocol.created_at) <= new Date(issued));
    }

    // The caller's id + org, required on every assigned_sessions INSERT — the
    // table's RLS check is (assigned_by = auth.uid() AND org_id =
    // current_user_org()). Fetched once and cached.
    let callerCtx = null;
    async function getCallerCtx() {
        if (callerCtx) return callerCtx;
        const session = await window.consoleAuth.getSession();
        const userId = session?.user?.id;
        const { data } = await window.consoleAuth.sb
            .from('profiles').select('org_id').eq('id', userId).maybeSingle();
        callerCtx = { assigned_by: userId, org_id: data?.org_id ?? null };
        return callerCtx;
    }

    // Re-run the protocol query and re-render (after a save/remove). Resets the
    // loading/empty state the same way the initial load does.
    async function reloadProtocols() {
        document.getElementById('protocols-grid').classList.add('hidden');
        document.getElementById('protocols-empty').classList.add('hidden');
        document.getElementById('protocols-loading').classList.remove('hidden');
        await loadProtocols();
    }

    // ════════════════════════════════════════════════════════════════════
    //  Protocol editor — create / edit / version / remove
    // ════════════════════════════════════════════════════════════════════
    (function () {
        const modal = document.getElementById('protocol-modal');
        const form = document.getElementById('protocol-form');
        const titleEl = document.getElementById('protocol-title');
        const errorEl = document.getElementById('pf-error');
        const saveBtn = document.getElementById('pf-save');
        const saveSpinner = saveBtn.querySelector('[data-spinner]');
        const saveLabel = saveBtn.querySelector('[data-label]');

        const bandsWrap = document.getElementById('pf-bands');
        const feedbackWrap = document.getElementById('pf-feedback');
        const auxField = document.getElementById('pf-aux-field');
        const auxSel = document.getElementById('pf-aux');
        const referenceWrap = document.getElementById('pf-reference');

        let editingId = null;   // null = creating; otherwise the protocol id

        // One-time: fill the AUX-position select + the feedback / reference chip
        // groups. Both use the same chip-toggle look (leading tick on select);
        // feedback is single-select (radios), reference is multi-select
        // (checkboxes).
        auxSel.innerHTML = AUX_POSITIONS.map(p => `<option value="${p}">${p}</option>`).join('');
        const chipMarkup = (type, name, c) => `
            <label class="chip-toggle" data-chip="${c}">
                <span class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <input type="${type}"${name ? ` name="${name}"` : ''} value="${c}">${c}
            </label>`;
        feedbackWrap.innerHTML = FEEDBACK_CHANNELS.map(c => chipMarkup('radio', 'pf-feedback', c)).join('');
        referenceWrap.innerHTML = FEEDBACK_CHANNELS.map(c => chipMarkup('checkbox', '', c)).join('');

        // Single-select feedback: read/write the checked radio.
        const getFeedback = () => feedbackWrap.querySelector('input:checked')?.value || 'AF7';
        function setFeedback(v) {
            const val = FEEDBACK_CHANNELS.includes(v) ? v : 'AF7';
            feedbackWrap.querySelectorAll('input').forEach(r => { r.checked = r.value === val; });
        }

        feedbackWrap.addEventListener('change', syncFeedback);
        // The feedback channel can't also be a reference — disable + uncheck it.
        function syncFeedback() {
            const fb = getFeedback();
            auxField.classList.toggle('hidden', fb !== 'AUX');
            referenceWrap.querySelectorAll('[data-chip]').forEach(label => {
                const isFeedback = label.dataset.chip === fb;
                label.classList.toggle('is-disabled', isFeedback);
                const cb = label.querySelector('input');
                cb.disabled = isFeedback;
                if (isFeedback) cb.checked = false;
            });
        }

        // Auto-grow the description textarea to fit its content.
        const descEl = document.getElementById('pf-description');
        function autoGrow() { descEl.style.height = 'auto'; descEl.style.height = descEl.scrollHeight + 'px'; }
        descEl.addEventListener('input', autoGrow);

        // ── Bands: 1–2 rows of {lo, hi, direction, threshold_z} ──────────
        function bandRow(band = {}) {
            const dir = (band.direction || 'reward').toLowerCase();
            const row = document.createElement('div');
            row.className = 'pf-band';
            row.innerHTML = `
                <input class="input input-sm tnum" type="number" min="0.5" max="${MAX_BAND_HZ}" step="0.5" data-band="lo" value="${band.lo ?? ''}" placeholder="4" aria-label="Low frequency (Hz)">
                <input class="input input-sm tnum" type="number" min="0.5" max="${MAX_BAND_HZ}" step="0.5" data-band="hi" value="${band.hi ?? ''}" placeholder="8" aria-label="High frequency (Hz)">
                <div class="segmented segmented-sm" data-band="direction">
                    <button type="button" data-dir="reward" class="${dir === 'reward' ? 'is-on' : ''}">Reward</button>
                    <button type="button" data-dir="punish" class="${dir === 'punish' ? 'is-on' : ''}">Punish</button>
                </div>
                <input class="input input-sm tnum" type="number" step="0.01" data-band="threshold_z" value="${band.threshold_z ?? ''}" placeholder="0" aria-label="Threshold Z (blank defaults to 0)">
                <button type="button" class="pf-band-remove" data-remove-band aria-label="Remove band" title="Remove band">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M6 6v14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V6"/></svg>
                </button>`;

            row.querySelectorAll('[data-dir]').forEach(b => b.addEventListener('click', () => {
                row.querySelectorAll('[data-dir]').forEach(x => x.classList.toggle('is-on', x === b));
            }));
            row.querySelector('[data-remove-band]').addEventListener('click', () => { row.remove(); syncBandAdd(); });
            return row;
        }

        function syncBandAdd() {
            // Cap at 2 bands.
            document.getElementById('pf-add-band').style.display =
                bandsWrap.children.length >= 2 ? 'none' : '';
        }
        document.getElementById('pf-add-band').addEventListener('click', () => {
            if (bandsWrap.children.length >= 2) return;
            bandsWrap.appendChild(bandRow());
            syncBandAdd();
        });

        // ── Open: prefill for edit, or blank for create ──────────────────
        function open(protocol) {
            editingId = protocol ? protocol.id : null;
            errorEl.classList.add('hidden');
            form.reset();
            bandsWrap.innerHTML = '';

            titleEl.textContent = protocol ? 'Edit protocol' : 'New protocol';
            saveLabel.textContent = protocol ? 'Save changes' : 'Create protocol';

            if (protocol) {
                document.getElementById('pf-name').value = protocol.name || '';
                document.getElementById('pf-description').value = protocol.description || '';
                const bands = Array.isArray(protocol.bands) ? protocol.bands.slice(0, 2) : [];
                bands.forEach(b => bandsWrap.appendChild(bandRow(b)));

                const ch = protocol.channels || {};
                setFeedback(ch.feedback);
                if (ch.aux_position && AUX_POSITIONS.includes(ch.aux_position)) auxSel.value = ch.aux_position;
                const refs = Array.isArray(ch.reference) ? ch.reference : [];
                referenceWrap.querySelectorAll('input').forEach(cb => { cb.checked = refs.includes(cb.value); });

                const mins = protocol.duration_seconds != null ? Math.round(protocol.duration_seconds / 60) : '';
                document.getElementById('pf-duration').value = mins;
                // Remember the exact original seconds, so an untouched duration
                // round-trips without re-rounding.
                document.getElementById('pf-duration').dataset.originalSeconds = protocol.duration_seconds ?? '';
                document.getElementById('pf-calibration').value = protocol.calibration_seconds ?? '';
            } else {
                setFeedback('AF7');
                delete document.getElementById('pf-duration').dataset.originalSeconds;
                document.getElementById('pf-calibration').value = '';
            }

            if (bandsWrap.children.length === 0) bandsWrap.appendChild(bandRow());
            syncBandAdd();
            syncFeedback();

            modal.hidden = false;
            autoGrow(); // size description now that it's visible (prefilled edits)
            document.getElementById('pf-name').focus();
        }
        function close() { modal.hidden = true; }

        // ── Read the form into a protocol payload (params only) ──────────
        function readForm() {
            const name = document.getElementById('pf-name').value.trim();
            if (!name) return { error: 'Please enter a protocol name.' };

            const description = document.getElementById('pf-description').value.trim();
            if (!description) return { error: 'Please enter a description.' };

            const bands = [];
            for (const row of bandsWrap.querySelectorAll('.pf-band')) {
                const lo = row.querySelector('[data-band="lo"]').value;
                const hi = row.querySelector('[data-band="hi"]').value;
                const zRaw = row.querySelector('[data-band="threshold_z"]').value;
                const direction = row.querySelector('[data-dir].is-on')?.dataset.dir || 'reward';
                if (lo === '' || hi === '') return { error: 'Each band needs a low and high frequency.' };
                if (+lo <= 0) return { error: 'Each band’s low frequency must be above 0 Hz.' };
                if (+lo >= +hi) return { error: 'Each band’s low frequency must be below its high frequency.' };
                if (+hi > MAX_BAND_HZ) return { error: `Each band’s high frequency must be ${MAX_BAND_HZ} Hz or below.` };
                // Always write a number — never null. The app and the licence
                // minter both assume an explicit value.
                bands.push({ lo: +lo, hi: +hi, direction, threshold_z: zRaw === '' ? DEFAULT_THRESHOLD_Z : +zRaw });
            }
            if (bands.length === 0) return { error: 'Add at least one band.' };

            const feedback = getFeedback();
            const reference = [...referenceWrap.querySelectorAll('input:checked')].map(cb => cb.value);
            const channels = { feedback, reference };
            if (feedback === 'AUX') channels.aux_position = auxSel.value;

            // Preserve exact original seconds if the minutes field is unchanged.
            // Blank falls back to the placeholder default (3 minutes).
            const DEFAULT_DURATION_MIN = 3;
            const durEl = document.getElementById('pf-duration');
            const mins = durEl.value;
            const orig = durEl.dataset.originalSeconds;
            let duration_seconds;
            if (mins === '') {
                duration_seconds = DEFAULT_DURATION_MIN * 60;
            } else {
                duration_seconds = (orig !== undefined && orig !== '' && Math.round(+orig / 60) === +mins)
                    ? +orig : Math.round(+mins * 60);
            }

            // Blank means "use the app's default", stored as null.
            const calRaw = document.getElementById('pf-calibration').value;
            if (calRaw !== '' && +calRaw < 0) return { error: 'Calibration can’t be negative.' };
            const calibration_seconds = calRaw === '' ? null : Math.round(+calRaw);

            return { payload: { name, description, bands, channels, duration_seconds, calibration_seconds } };
        }

        function setSaving(on) {
            saveBtn.disabled = on;
            saveSpinner.classList.toggle('hidden', !on);
        }

        // Stable serialisation of the PARAMETERS only (bands / channels /
        // duration) — the fields that change how a session is interpreted.
        // Name and description are excluded on purpose: they're labels, so
        // editing them must never spawn a new version.
        function paramsKey(p) {
            return JSON.stringify({
                bands: (p.bands || []).map(b => ({
                    lo: +b.lo, hi: +b.hi,
                    direction: (b.direction || 'reward').toLowerCase(),
                    // Normalise legacy nulls to the canonical default, so opening
                    // a pre-backfill protocol and saving it unchanged doesn't
                    // read as a parameter change and spawn a pointless version.
                    threshold_z: b.threshold_z == null ? DEFAULT_THRESHOLD_Z : +b.threshold_z,
                })),
                channels: {
                    feedback: p.channels?.feedback ?? null,
                    reference: [...(p.channels?.reference || [])].sort(),
                    aux_position: p.channels?.aux_position ?? null,
                },
                duration_seconds: p.duration_seconds ?? null,
                calibration_seconds: p.calibration_seconds ?? null,
            });
        }

        // ── Save: create / edit-in-place / version ───────────────────────
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorEl.classList.add('hidden');
            const { payload, error } = readForm();
            if (error) { errorEl.textContent = error; errorEl.classList.remove('hidden'); return; }

            const sb = window.consoleAuth.sb;
            setSaving(true);
            try {
                if (!editingId) {
                    // Create. RLS requires assigned_by + org_id on the row.
                    const ctx = await getCallerCtx();
                    const { error: insErr } = await sb.from('assigned_sessions')
                        .insert({ client_id: clientId, ...ctx, ...payload });
                    if (insErr) throw insErr;
                } else {
                    const original = protocolsById.get(editingId);
                    const paramsChanged = !original || paramsKey(payload) !== paramsKey(original);
                    const inUse = !!original && isProtocolInUse(original);

                    // Version ONLY when the parameters changed on a protocol the
                    // client could already have run — see isProtocolInUse(). A
                    // name/description-only edit, or any edit before it has been
                    // used, just updates in place.
                    if (inUse && paramsChanged) {
                        // Insert the new row FIRST, then archive the old. If the
                        // insert fails nothing changed; if the archive fails we
                        // have a harmless duplicate, never a gap.
                        const ctx = await getCallerCtx();
                        const { error: insErr } = await sb.from('assigned_sessions')
                            .insert({ client_id: clientId, ...ctx, ...payload });
                        if (insErr) throw insErr;
                        const { error: arcErr } = await sb.from('assigned_sessions')
                            .update({ archived_at: new Date().toISOString() }).eq('id', editingId);
                        if (arcErr) throw arcErr;
                    } else {
                        const { error: updErr } = await sb.from('assigned_sessions')
                            .update(payload).eq('id', editingId);
                        if (updErr) throw updErr;
                    }
                }
                close();
                await reloadProtocols();
            } catch (err) {
                errorEl.textContent = err.message || 'Could not save the protocol. Please try again.';
                errorEl.classList.remove('hidden');
            } finally {
                setSaving(false);
            }
        });

        modal.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', close));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });

        // ── Triggers: New button + delegated card Edit buttons ───────────
        document.getElementById('add-protocol-btn').addEventListener('click', () => open(null));
        document.getElementById('protocols-grid').addEventListener('click', (e) => {
            const btn = e.target.closest('[data-action]');
            if (!btn) return;
            const protocol = protocolsById.get(btn.dataset.id);
            if (!protocol) return;
            if (btn.dataset.action === 'edit') open(protocol);
            else if (btn.dataset.action === 'remove') openRemoveProtocol(protocol);
        });

        // ── Remove protocol: archive if it has sessions, else hard delete ─
        function openRemoveProtocol(protocol) {
            const m = document.getElementById('remove-protocol-modal');
            const inUse = isProtocolInUse(protocol);
            const confirmBtn = document.getElementById('rp-confirm');
            const spinner = confirmBtn.querySelector('[data-spinner]');
            const rpError = document.getElementById('rp-error');
            rpError.classList.add('hidden');

            // Anything the client could have run gets archived, never deleted —
            // its settings have to stay readable for the sessions that used it,
            // including offline sessions that haven't been imported yet.
            document.getElementById('rp-body').textContent = inUse
                ? `“${protocol.name || 'Untitled'}” has been used, so it will be archived — its past sessions and their settings are kept, it just won’t appear in the active list.`
                : `“${protocol.name || 'Untitled'}” has never been used, so it will be permanently deleted.`;
            confirmBtn.querySelector('[data-label]').textContent = inUse ? 'Archive' : 'Delete';

            const onConfirm = async () => {
                confirmBtn.disabled = true; spinner.classList.remove('hidden');
                const sb = window.consoleAuth.sb;
                try {
                    const { error } = inUse
                        ? await sb.from('assigned_sessions').update({ archived_at: new Date().toISOString() }).eq('id', protocol.id)
                        : await sb.from('assigned_sessions').delete().eq('id', protocol.id);
                    if (error) throw error;
                    m.hidden = true;
                    await reloadProtocols();
                } catch (err) {
                    rpError.textContent = err.message || 'Could not remove the protocol. Please try again.';
                    rpError.classList.remove('hidden');
                } finally {
                    confirmBtn.disabled = false; spinner.classList.add('hidden');
                }
            };

            // Replace the button to drop any previous protocol's handler.
            const fresh = confirmBtn.cloneNode(true);
            confirmBtn.replaceWith(fresh);
            fresh.addEventListener('click', onConfirm);

            m.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', () => { m.hidden = true; }));
            m.hidden = false;
            fresh.focus();
        }
        document.addEventListener('keydown', (e) => {
            const m = document.getElementById('remove-protocol-modal');
            if (e.key === 'Escape' && !m.hidden) m.hidden = true;
        });
    })();

    // Map<protocol_id, count> — only completed sessions count.
    async function fetchSessionCountsByProtocol() {
        const map = new Map();
        const { data, error } = await window.consoleAuth.sb
            .from('sessions')
            .select('protocol_id')
            .eq('user_id', clientId)
            .not('protocol_id', 'is', null)
            .not('ended_at', 'is', null);
        if (error || !data) return map;
        for (const row of data) {
            map.set(row.protocol_id, (map.get(row.protocol_id) || 0) + 1);
        }
        return map;
    }

    function renderProtocol(p, sessionCount) {
        const bands = Array.isArray(p.bands) ? p.bands.slice(0, 2) : [];
        const channels = p.channels || {};
        return `
            <article class="card p-6">
                <div class="flex items-start justify-between gap-6">
                    <div class="min-w-0">
                        <h3 class="text-section">${escapeHtml(p.name || 'Untitled')}</h3>
                        ${p.description ? `<p class="text-caption text-muted mt-1 leading-relaxed">${escapeHtml(p.description)}</p>` : ''}
                    </div>
                    <div class="shrink-0 text-caption text-muted whitespace-nowrap text-right">
                        <div>${sessionCount} session${sessionCount === 1 ? '' : 's'} completed</div>
                        <div class="mt-0.5">Created ${formatDate(p.created_at)}</div>
                    </div>
                </div>

                <div class="mt-5 flex flex-wrap items-start gap-x-10 gap-y-4">
                    <div>
                        <div class="meta-label">Bands</div>
                        <div class="mt-2 flex flex-col items-start gap-2">
                            ${bands.length ? bands.map(renderBand).join('') : '<span class="text-caption text-muted">—</span>'}
                        </div>
                    </div>
                    <div>
                        <div class="meta-label">Channels</div>
                        <div class="text-caption text-ink mt-2">${renderChannels(channels)}</div>
                    </div>
                    <div>
                        <div class="meta-label">Duration</div>
                        <div class="text-caption text-ink mt-2">${formatDurationWithCalibration(p)}</div>
                    </div>

                    <div class="ml-auto self-end flex items-center gap-2">
                        <button type="button" data-action="edit" data-id="${escapeHtml(p.id)}" class="btn btn-secondary btn-sm">Edit</button>
                        <button type="button" data-action="remove" data-id="${escapeHtml(p.id)}" class="btn btn-danger btn-sm">Remove</button>
                    </div>
                </div>
            </article>
        `;
    }

    async function loadSessions() {
        const { data, error } = await window.consoleAuth.sb
            .from('sessions')
            .select('id, started_at, ended_at, summary, protocol_id, assigned_sessions(name)')
            .eq('user_id', clientId)
            .order('started_at', { ascending: false });

        const loading = document.getElementById('sessions-loading');
        const empty = document.getElementById('sessions-empty');
        const table = document.getElementById('sessions-table');
        const list = document.getElementById('sessions-list');

        loading.classList.add('hidden');

        if (error || !data) {
            empty.textContent = 'Could not load sessions.';
            empty.classList.remove('hidden');
            return;
        }
        if (data.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        sessionRows = data;
        table.classList.remove('hidden');
        renderSessionsPage();
    }

    // ── Client-side pagination ──────────────────────────────────────────
    // All sessions are already in memory, so paging is pure slicing — no
    // extra queries. The pager stays hidden when everything fits one page.
    const SESSIONS_PER_PAGE = 10;
    let sessionRows = [];
    let sessionsPage = 0;

    function renderSessionsPage() {
        const totalPages = Math.ceil(sessionRows.length / SESSIONS_PER_PAGE);
        sessionsPage = Math.min(Math.max(sessionsPage, 0), totalPages - 1);

        const startIdx = sessionsPage * SESSIONS_PER_PAGE;
        const pageRows = sessionRows.slice(startIdx, startIdx + SESSIONS_PER_PAGE);
        document.getElementById('sessions-list').innerHTML = pageRows.map(renderSession).join('');

        const pager = document.getElementById('sessions-pager');
        if (totalPages <= 1) { pager.classList.add('hidden'); return; }
        pager.classList.remove('hidden');
        pager.classList.add('flex');

        document.getElementById('sessions-range').textContent =
            `${startIdx + 1}–${startIdx + pageRows.length} of ${sessionRows.length}`;
        document.getElementById('sessions-prev').disabled = sessionsPage === 0;
        document.getElementById('sessions-next').disabled = sessionsPage >= totalPages - 1;
    }

    document.getElementById('sessions-prev').addEventListener('click', () => { sessionsPage--; renderSessionsPage(); });
    document.getElementById('sessions-next').addEventListener('click', () => { sessionsPage++; renderSessionsPage(); });

    // ── Session → read-only protocol view ───────────────────────────────
    // The session's protocol may be an archived version, so fetch it fresh by
    // id rather than relying on the active-protocols cache. Reuses the same
    // band/channel/duration renderers as the protocol cards.
    (function () {
        const modal = document.getElementById('session-protocol-modal');
        const body = document.getElementById('spm-body');
        const titleEl = document.getElementById('spm-title');
        const whenEl = document.getElementById('spm-when');

        const close = () => { modal.hidden = true; };
        modal.querySelectorAll('[data-close]').forEach(el => el.addEventListener('click', close));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });

        document.getElementById('sessions-list').addEventListener('click', async (e) => {
            const btn = e.target.closest('[data-view-protocol]');
            if (!btn) return;
            const id = btn.dataset.viewProtocol;

            titleEl.textContent = 'Protocol';
            whenEl.textContent = btn.dataset.when ? `Session · ${btn.dataset.when}` : '';
            body.innerHTML = `<div class="skeleton h-28 rounded-card"></div>`;
            modal.hidden = false;
            modal.querySelector('[data-close]').focus();

            const { data, error } = await window.consoleAuth.sb
                .from('assigned_sessions')
                .select('name, description, bands, channels, duration_seconds, calibration_seconds, archived_at, created_at')
                .eq('id', id)
                .maybeSingle();

            if (error || !data) {
                body.innerHTML = `<p class="text-body text-muted">Could not load this protocol.</p>`;
                return;
            }
            titleEl.textContent = data.name || 'Untitled';
            body.innerHTML = renderProtocolReadonly(data);
        });

        function renderProtocolReadonly(p) {
            const bands = Array.isArray(p.bands) ? p.bands.slice(0, 2) : [];
            const channels = p.channels || {};
            const archived = p.archived_at
                ? `<span class="chip chip-neutral">Archived version</span>` : '';
            return `
                ${p.description ? `<p class="text-body text-muted">${escapeHtml(p.description)}</p>` : ''}
                ${archived ? `<div class="mt-3">${archived}</div>` : ''}
                <div class="mt-6 pt-6 border-t border-line grid grid-cols-1 sm:grid-cols-3 gap-6">
                    <div>
                        <div class="meta-label">Bands</div>
                        <div class="mt-2 flex flex-col items-start gap-2">
                            ${bands.length ? bands.map(renderBand).join('') : '<span class="text-caption text-muted">—</span>'}
                        </div>
                    </div>
                    <div>
                        <div class="meta-label">Channels</div>
                        <div class="text-caption text-ink mt-2">${renderChannels(channels)}</div>
                    </div>
                    <div>
                        <div class="meta-label">Duration</div>
                        <div class="text-caption text-ink mt-2">${formatDurationWithCalibration(p)}</div>
                    </div>
                </div>`;
        }
    })();

    function renderSession(s) {
        const summary = s.summary || {};
        const duration = summary.duration_s ?? (s.ended_at && s.started_at
            ? (new Date(s.ended_at) - new Date(s.started_at)) / 1000 : null);
        const pct = summary.pct_above != null ? Math.round(summary.pct_above * 100) + '%' : '—';
        const streak = summary.max_streak_s != null ? formatDuration(summary.max_streak_s) : '—';
        const name = s.assigned_sessions?.name || 'Ad-hoc session';
        const when = formatDateTime(s.started_at);

        // Only sessions tied to a protocol are clickable; ad-hoc ones are plain.
        const nameCell = s.protocol_id
            ? `<button type="button" class="text-ink font-medium text-left hover:text-accent transition"
                       data-view-protocol="${escapeHtml(s.protocol_id)}" data-when="${escapeHtml(when)}">${escapeHtml(name)}</button>`
            : `<span class="text-muted">${escapeHtml(name)}</span>`;

        return `
            <tr>
                <td>${nameCell}</td>
                <td class="text-muted tnum">${when}</td>
                <td class="text-right tnum">${formatDuration(duration)}</td>
                <td class="text-right tnum">${pct}</td>
                <td class="text-right tnum">${streak}</td>
            </tr>`;
    }

    function formatDateTime(iso) {
        if (!iso) return '—';
        const d = new Date(iso);
        return d.toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function renderBand(b) {
        const dir = (b.direction || '').toLowerCase();
        const cls = dir === 'reward' ? 'reward' : dir === 'punish' ? 'punish' : '';
        const dirLabel = dir ? dir.charAt(0).toUpperCase() + dir.slice(1) : '';
        // Legacy rows may still hold null; show the same canonical default the
        // editor writes and the app assumes.
        const zVal = b.threshold_z == null ? DEFAULT_THRESHOLD_Z : +b.threshold_z;
        return `<span class="band-chip ${cls}"><span class="dot"></span>${b.lo}–${b.hi} Hz${dirLabel ? ' · ' + dirLabel : ''} · Z ${zVal.toFixed(2)}</span>`;
    }

    function renderChannels(ch) {
        const fb = ch.feedback || '—';
        const refs = Array.isArray(ch.reference) && ch.reference.length ? ch.reference.join(', ') : 'none';
        const dot = '<span class="text-muted"> · </span>';
        let out = `${escapeHtml(fb)}${dot}ref ${escapeHtml(refs)}`;
        if (ch.feedback === 'AUX' && ch.aux_position) {
            out += `${dot}${escapeHtml(ch.aux_position.toUpperCase())}`;
        }
        return out;
    }

    // "20 min · 30 s calibration", or just the duration when calibration is
    // unset (the app falls back to its own default).
    function formatDurationWithCalibration(p) {
        const base = formatDuration(p.duration_seconds);
        return p.calibration_seconds == null
            ? base
            : `${base}<span class="text-muted"> · </span>${formatDuration(p.calibration_seconds)} calibration`;
    }

    // 75 → "1 min 15 s", 1200 → "20 min", 5400 → "1 h 30 min"
    function formatDuration(s) {
        if (s == null) return '—';
        s = Math.round(s);
        const h = Math.floor(s / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        if (h) return m ? `${h} h ${m} min` : `${h} h`;
        if (m) return sec && m < 5 ? `${m} min ${sec} s` : `${m} min`;
        return `${sec} s`;
    }

    function formatDate(iso) {
        if (!iso) return '—';
        const d = new Date(iso);
        return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function fullName(p) {
        const parts = [p.display_name, p.surname].filter(Boolean);
        return parts.length ? parts.join(' ') : '(unnamed)';
    }

    function escapeHtml(s) {
        return String(s ?? '').replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c]));
    }
</script>
