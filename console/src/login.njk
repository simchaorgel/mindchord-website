---
layout: base.njk
title: Mindchord Console | Sign in
---
<a href="/" class="absolute top-6 left-6 md:top-8 md:left-10 z-30 flex items-center gap-2.5">
    <img src="/console/media/favicon.png" alt="" class="h-8 md:h-9 w-auto object-contain">
    <span class="wordmark text-xl md:text-2xl">Mindchord</span>
</a>

<!-- py-20 keeps the card clear of the absolutely-positioned wordmark above, and
     lets the page scroll to it in landscape instead of centring it off-screen. -->
<main class="relative z-10 min-h-screen flex items-center justify-center px-4 sm:px-6 py-20 md:py-24">
    <section class="w-full max-w-lg p-6 sm:p-8 md:p-10 bg-white border border-[#2C2825]/10 rounded-2xl shadow-sm">
        <div class="flex items-center justify-center gap-2.5 sm:gap-3">
            <img src="/console/media/favicon.png" alt="" class="h-7 sm:h-8 md:h-9 w-auto object-contain">
            <h2 class="wordmark text-xl sm:text-2xl md:text-[28px] tracking-tight">Mindchord Console</h2>
        </div>

        <!-- Email screen -->
        <form id="email-form" class="mt-6 flex flex-col items-center" autocomplete="on">
            <p class="wordmark max-w-[440px] text-center text-sm sm:text-base text-[#6B635A]">
                Please enter your email address to sign in
            </p>

            <!-- Two separate full pills stacked below sm, rejoined into the single
                 left/right pill from sm up. -->
            <div class="w-full max-w-[440px] mt-6 flex flex-col gap-3 sm:flex-row sm:gap-0">
                <!-- The grow is sm-only on purpose: in the stacked column `flex-1`
                     would apply to the main axis (height), overriding h-12 with a
                     0 basis and letting the field collapse. min-w-0 is the row-mode
                     counterpart — a flex item's auto min-width floors at min-content,
                     which for an <input> comes from its default `size`, so without
                     it the field refuses to shrink and pushes the button off. -->
                <input
                    id="console-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    placeholder="you@clinic.com"
                    class="wordmark w-full sm:flex-1 min-w-0 h-12 px-5 bg-[#F5F0EB] rounded-full sm:rounded-r-none focus:outline-none">
                <button
                    type="submit"
                    class="wordmark relative isolate shrink-0 w-full sm:w-auto px-6 h-12 sm:min-w-[140px] flex items-center justify-center gap-2 text-[#F5F0EB] font-medium rounded-full sm:rounded-l-none ring-4 ring-transparent hover:ring-[#7A8F7E]/30 transition-all duration-200 disabled:opacity-90 disabled:cursor-not-allowed before:content-[''] before:absolute before:inset-0 before:-z-10 before:rounded-full sm:before:rounded-l-none before:bg-gradient-to-b before:from-[#869C8A] before:to-[#6A7F6E] before:transition-all before:duration-200 hover:before:brightness-90">
                    <svg data-spinner class="hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"></path>
                    </svg>
                    <span data-btn-label>Send code</span>
                </button>
            </div>
        </form>

        <!-- Code verification screen — hidden until the email form is submitted -->
        <div id="code-screen" class="mt-6 hidden flex flex-col items-center">
            <p class="wordmark max-w-[440px] text-center text-sm sm:text-base text-[#6B635A]">
                Enter the 6-digit code sent to <span id="code-email-display" class="text-[#2C2825]"></span>
            </p>

            <!-- The boxes size themselves off the row rather than a fixed w-14:
                 6×56px + gaps needs 376px, which overflows every phone. `flex-1
                 min-w-0` lets them shrink to whatever fits, `aspect-square` keeps
                 them square at any width, and max-w-[56px] holds the original
                 desktop size once the row is wide enough. -->
            <div id="code-form" class="mt-6 w-full max-w-[380px] flex justify-center gap-1.5 sm:gap-2">
                <input data-code-box type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code"
                    class="wordmark flex-1 min-w-0 max-w-[56px] aspect-square bg-[#F5F0EB] rounded-lg text-center text-xl sm:text-2xl focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
                <input data-code-box type="text" inputmode="numeric" maxlength="1"
                    class="wordmark flex-1 min-w-0 max-w-[56px] aspect-square bg-[#F5F0EB] rounded-lg text-center text-xl sm:text-2xl focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
                <input data-code-box type="text" inputmode="numeric" maxlength="1"
                    class="wordmark flex-1 min-w-0 max-w-[56px] aspect-square bg-[#F5F0EB] rounded-lg text-center text-xl sm:text-2xl focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
                <input data-code-box type="text" inputmode="numeric" maxlength="1"
                    class="wordmark flex-1 min-w-0 max-w-[56px] aspect-square bg-[#F5F0EB] rounded-lg text-center text-xl sm:text-2xl focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
                <input data-code-box type="text" inputmode="numeric" maxlength="1"
                    class="wordmark flex-1 min-w-0 max-w-[56px] aspect-square bg-[#F5F0EB] rounded-lg text-center text-xl sm:text-2xl focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
                <input data-code-box type="text" inputmode="numeric" maxlength="1"
                    class="wordmark flex-1 min-w-0 max-w-[56px] aspect-square bg-[#F5F0EB] rounded-lg text-center text-xl sm:text-2xl focus:outline-none focus:ring-2 focus:ring-[#7A8F7E]">
            </div>

            <!-- py-2 grows the tap targets from ~20px to a thumb-sized 36px; the
                 margin drops to mt-3 so the added padding doesn't widen the gap. -->
            <div class="mt-3 flex justify-center gap-10 sm:gap-16 text-sm text-[#6B635A] wordmark">
                <button type="button" id="back-to-email" class="py-2 px-1 hover:text-[#2C2825] transition-colors">
                    ← Back
                </button>
                <button type="button" id="cant-sign-in" class="py-2 px-1 hover:text-[#2C2825] transition-colors">
                    Can't sign in?
                </button>
            </div>

            <p id="code-error" class="wordmark mt-4 text-sm text-[#B85042] text-center hidden"></p>
        </div>
    </section>
</main>

<script>
    // If already signed in, skip straight to the dashboard.
    window.consoleAuth.redirectIfSignedIn();

    const emailForm = document.getElementById('email-form');
    const emailInput = document.getElementById('console-email');
    const codeScreen = document.getElementById('code-screen');
    const emailDisplay = document.getElementById('code-email-display');
    const codeBoxes = Array.from(document.querySelectorAll('[data-code-box]'));
    const codeError = document.getElementById('code-error');

    function showCodeError(msg) {
        codeError.textContent = msg;
        codeError.classList.remove('hidden');
    }
    function clearCodeError() {
        codeError.classList.add('hidden');
        codeError.textContent = '';
    }

    emailForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        const submitBtn = emailForm.querySelector('button[type="submit"]');
        const spinner = submitBtn.querySelector('[data-spinner]');
        const label = submitBtn.querySelector('[data-btn-label]');
        submitBtn.disabled = true;
        spinner.classList.remove('hidden');
        label.textContent = 'Sending…';
        const { error } = await window.consoleAuth.sendOtp(email);
        submitBtn.disabled = false;
        spinner.classList.add('hidden');
        label.textContent = 'Send code';
        if (error) {
            alert(error.message || 'Could not send code. Check the email and try again.');
            return;
        }
        emailDisplay.textContent = email;
        emailForm.classList.add('hidden');
        codeScreen.classList.remove('hidden');
        codeBoxes[0].focus();
    });

    document.getElementById('back-to-email').addEventListener('click', () => {
        codeBoxes.forEach(b => { b.value = ''; });
        codeScreen.classList.add('hidden');
        emailForm.classList.remove('hidden');
        emailInput.focus();
    });

    codeBoxes.forEach((box, i) => {
        box.addEventListener('beforeinput', (e) => {
            if (e.data !== null && !/^\d$/.test(e.data)) e.preventDefault();
        });
        box.addEventListener('input', () => {
            if (box.value && i < codeBoxes.length - 1) codeBoxes[i + 1].focus();
        });
        box.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !box.value && i > 0) codeBoxes[i - 1].focus();
        });
        box.addEventListener('paste', (e) => {
            e.preventDefault();
            const digits = (e.clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, codeBoxes.length);
            if (!digits) return;
            digits.split('').forEach((d, j) => { codeBoxes[j].value = d; });
            codeBoxes[Math.min(digits.length, codeBoxes.length - 1)].focus();
            if (digits.length === codeBoxes.length) verifyCode();
        });
    });

    codeBoxes[codeBoxes.length - 1].addEventListener('input', () => {
        if (codeBoxes.every(b => b.value.length === 1)) verifyCode();
    });

    async function verifyCode() {
        const token = codeBoxes.map(b => b.value).join('');
        if (token.length !== codeBoxes.length) return;
        clearCodeError();
        codeBoxes.forEach(b => { b.disabled = true; });
        const { error } = await window.consoleAuth.verifyOtp(emailInput.value.trim(), token);
        if (error) {
            showCodeError('Invalid or expired code. Try again.');
            codeBoxes.forEach(b => { b.disabled = false; b.value = ''; });
            codeBoxes[0].focus();
            return;
        }
        window.location.replace('/console/dashboard/');
    }
</script>
