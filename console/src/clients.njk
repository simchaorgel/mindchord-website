---
layout: sidebar.njk
title: Mindchord Console | Clients
nav: clients
---
<div class="flex items-end justify-between gap-6">
    <div>
        <h1 class="text-display">Clients</h1>
        <p class="text-body text-muted mt-2 max-w-xl">
            Select a client to review their sessions and protocols.
        </p>
    </div>

    <a href="/console/add-client/" class="btn btn-primary shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6Z"/>
        </svg>
        Add client
    </a>
</div>

<!-- Skeleton rows render immediately; real rows replace them once the
     supabase query resolves. -->
<section class="mt-8 card overflow-hidden">
    <ul id="clients-loading" class="divide-y divide-line">
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-44"></span><span class="skeleton h-3 w-32"></span></li>
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-52"></span><span class="skeleton h-3 w-28"></span></li>
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-36"></span><span class="skeleton h-3 w-36"></span></li>
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-48"></span><span class="skeleton h-3 w-24"></span></li>
    </ul>
    <div id="clients-empty" class="hidden py-12 text-center text-muted text-body">
        No clients yet. Add your first client to get started.
    </div>
    <ul id="clients-list" class="hidden divide-y divide-line"></ul>
</section>

<script>
    loadPeople('client', {
        loadingId: 'clients-loading',
        emptyId: 'clients-empty',
        listId: 'clients-list',
    });

    // Loads profiles for a given role. RLS scopes rows to the calling
    // clinician's org. Sessions are fetched separately and joined in JS
    // (profiles ↔ sessions share auth.users as the FK target, not each
    // other), so embedding would not work without a schema change.
    async function loadPeople(role, ids) {
        const loading = document.getElementById(ids.loadingId);
        const empty = document.getElementById(ids.emptyId);
        const list = document.getElementById(ids.listId);

        const { data: people, error } = await window.consoleAuth.sb
            .from('profiles')
            .select('id, display_name, surname')
            .eq('role', role)
            .order('surname')
            .order('display_name');

        loading.classList.add('hidden');

        if (error || !people) {
            empty.textContent = 'Could not load.';
            empty.classList.remove('hidden');
            return;
        }
        if (people.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        const statsByUser = await fetchSessionStats(people.map(p => p.id));

        list.innerHTML = people.map(p => {
            const stats = statsByUser.get(p.id);
            const count = stats?.count ?? 0;
            const last = stats?.last;
            const countLabel = count + ' session' + (count === 1 ? '' : 's');
            const subline = count === 0
                ? 'No sessions yet'
                : countLabel + ' · last ' + formatRelativeDate(last);
            return `
            <li>
                <a href="/console/client/?id=${encodeURIComponent(p.id)}"
                   class="flex items-center justify-between px-6 py-4 group hover:bg-surface-2 transition">
                    <div class="flex items-center gap-4 min-w-0">
                        <span class="w-9 h-9 rounded-full bg-accent-weak text-accent-ink grid place-items-center text-caption font-semibold shrink-0">${escapeHtml(initials(p))}</span>
                        <div class="min-w-0">
                            <div class="text-body font-medium text-ink group-hover:text-accent transition truncate">${escapeHtml(fullName(p))}</div>
                            <div class="text-caption text-muted truncate">${subline}</div>
                        </div>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                         class="w-4 h-4 shrink-0 text-muted group-hover:text-accent transition">
                        <path d="M9.3 6.3a1 1 0 0 1 1.4 0l5.3 5.3a.5.5 0 0 1 0 .8l-5.3 5.3a1 1 0 1 1-1.4-1.42L13.18 12 9.3 8.12a1 1 0 0 1 0-1.42Z"/>
                    </svg>
                </a>
            </li>`;
        }).join('');
        list.classList.remove('hidden');
    }

    // Returns Map<user_id, {count, last: Date}> from completed sessions.
    async function fetchSessionStats(userIds) {
        const map = new Map();
        if (userIds.length === 0) return map;
        const { data, error } = await window.consoleAuth.sb
            .from('sessions')
            .select('user_id, ended_at')
            .in('user_id', userIds)
            .not('ended_at', 'is', null);
        if (error || !data) return map;
        for (const row of data) {
            const d = new Date(row.ended_at);
            const cur = map.get(row.user_id);
            if (!cur) {
                map.set(row.user_id, { count: 1, last: d });
            } else {
                cur.count += 1;
                if (d > cur.last) cur.last = d;
            }
        }
        return map;
    }

    function formatRelativeDate(d) {
        const now = new Date();
        const diffMs = now - d;
        const day = 24 * 60 * 60 * 1000;
        if (diffMs < day && now.getDate() === d.getDate()) return 'today';
        if (diffMs < 2 * day) return 'yesterday';
        const days = Math.floor(diffMs / day);
        if (days < 7) return days + ' days ago';
        return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function fullName(p) {
        const parts = [p.display_name, p.surname].filter(Boolean);
        return parts.length ? parts.join(' ') : '(unnamed)';
    }

    function initials(p) {
        const a = (p.display_name || '').trim();
        const b = (p.surname || '').trim();
        const i = (a[0] || '') + (b[0] || '');
        return i.toUpperCase() || '–';
    }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c]));
    }
</script>
