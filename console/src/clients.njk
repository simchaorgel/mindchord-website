nav: clients
---
<style>
    /* Matches the dashboard and organization mastheads: title size, dialled
       back from the .text-title token's 600. Scoped (0,1,1) so it beats the
       weight baked into the token without depending on Tailwind's ordering. */
    .masthead h1 { font-weight: 500; }
</style>

<header class="masthead flex items-center justify-between gap-4 flex-wrap">
    <h1 class="text-title">Clients</h1>

    <a href="/console/add-client/" class="btn btn-primary btn-sm shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M11 11V5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6Z"/>
        </svg>
        Add client
    </a>
</header>

<!-- Skeleton rows render immediately; real rows replace them once the
     supabase query resolves. -->
<section class="mt-8 card overflow-hidden">
    <ul id="clients-loading" class="divide-y divide-line">
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-44"></span><span class="skeleton h-3 w-32"></span></li>
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-52"></span><span class="skeleton h-3 w-28"></span></li>
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-36"></span><span class="skeleton h-3 w-36"></span></li>
        <li class="px-6 py-4 flex items-center gap-6"><span class="skeleton h-4 w-48"></span><span class="skeleton h-3 w-24"></span></li>
    </ul>
    <div id="clients-empty" class="hidden py-12 text-center text-muted text-body">
        No clients yet. Add your first client to get started.
    </div>
    <ul id="clients-list" class="hidden divide-y divide-line"></ul>
</section>

<script>
    const { escapeHtml, fullName, initials, formatRelativeDate, classifyClient } = window.consoleUI;

    loadClients();

    // RLS scopes rows to the calling clinician's org. Sessions and protocols
    // are fetched separately and joined in JS (profiles ↔ sessions share
    // auth.users as the FK target, not each other), so embedding would not
    // work without a schema change.
    async function loadClients() {
        const sb = window.consoleAuth.sb;
        const loading = document.getElementById('clients-loading');
        const empty = document.getElementById('clients-empty');
        const list = document.getElementById('clients-list');

        // licence_* columns are selected for classifyClient, not for display.
        const { data: people, error } = await sb
            .from('profiles')
            .select('id, display_name, surname, licence_issued_at, licence_expires_at')
            .eq('role', 'client')
            .order('surname')
            .order('display_name');

        loading.classList.add('hidden');

        if (error || !people) {
            empty.textContent = 'Could not load.';
            empty.classList.remove('hidden');
            return;
        }
        if (people.length === 0) {
            empty.classList.remove('hidden');
            return;
        }

        const ids = people.map(p => p.id);
        const [statsByUser, hasProtocol] = await Promise.all([
            fetchSessionStats(ids),
            fetchClientsWithProtocol(ids),
        ]);

        list.innerHTML = people.map(p => {
            const stats = statsByUser.get(p.id);
            const count = stats?.count ?? 0;
            const last = stats?.last;
            const countLabel = count + ' session' + (count === 1 ? '' : 's');
            const subline = count === 0
                ? 'No sessions yet'
                : countLabel + ' · last ' + formatRelativeDate(last);

            // Only clients needing something get a chip. A chip on every row
            // would flatten the signal — the point is that the eye lands on
            // the exceptions while scanning alphabetically.
            const flag = classifyClient(p, hasProtocol.has(p.id), last);
            const chip = flag
                ? `<span class="chip ${flag.chip} shrink-0">${escapeHtml(flag.label)}</span>`
                : '';

            return `
            <li>
                <a href="/console/client/?id=${encodeURIComponent(p.id)}"
                   class="flex items-center justify-between gap-4 px-6 py-4 group hover:bg-surface-2 transition">
                    <div class="flex items-center gap-4 min-w-0">
                        <span class="w-9 h-9 rounded-full bg-accent-weak text-accent-ink grid place-items-center text-caption font-semibold shrink-0">${escapeHtml(initials(p))}</span>
                        <div class="min-w-0">
                            <div class="text-body font-medium text-ink group-hover:text-accent transition truncate">${escapeHtml(fullName(p))}</div>
                            <div class="text-caption text-muted truncate">${subline}</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        ${chip}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                             class="w-4 h-4 text-muted group-hover:text-accent transition">
                            <path d="M9.3 6.3a1 1 0 0 1 1.4 0l5.3 5.3a.5.5 0 0 1 0 .8l-5.3 5.3a1 1 0 1 1-1.4-1.42L13.18 12 9.3 8.12a1 1 0 0 1 0-1.42Z"/>
                        </svg>
                    </div>
                </a>
            </li>`;
        }).join('');
        list.classList.remove('hidden');
    }

    // Set of client ids holding at least one un-archived protocol.
    async function fetchClientsWithProtocol(clientIds) {
        const set = new Set();
        if (clientIds.length === 0) return set;
        const { data, error } = await window.consoleAuth.sb
            .from('assigned_sessions')
            .select('client_id')
            .in('client_id', clientIds)
            .is('archived_at', null);
        if (error || !data) return set;
        for (const row of data) set.add(row.client_id);
        return set;
    }

    // Returns Map<user_id, {count, last: Date}> from completed sessions.
    async function fetchSessionStats(userIds) {
        const map = new Map();
        if (userIds.length === 0) return map;
        const { data, error } = await window.consoleAuth.sb
            .from('sessions')
            .select('user_id, ended_at')
            .in('user_id', userIds)
            .not('ended_at', 'is', null);
        if (error || !data) return map;
        for (const row of data) {
            const d = new Date(row.ended_at);
            const cur = map.get(row.user_id);
            if (!cur) {
                map.set(row.user_id, { count: 1, last: d });
            } else {
                cur.count += 1;
                if (d > cur.last) cur.last = d;
            }
        }
        return map;
    }
</script>
