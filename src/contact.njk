---
layout: base.njk
title: Mindchord | Contact Us
nav: contact
---

{% block head %}
    <link rel="stylesheet" href="/styles/contact_style.css">
{% endblock %}

<main id="contact-main" class="flex-1 relative pl-6 md:pl-20 pr-6 md:pr-0 pt-10 md:pt-0 pb-14 md:pb-0 flex flex-col cursor-text">
    <div class="w-full flex-1 flex flex-col">

        <form name="contact"
                method="POST"
                data-netlify="true"
                data-netlify-honeypot="bot-field"
                class="grid grid-cols-1 md:grid-cols-[2fr_3fr] md:grid-rows-[auto_1fr] gap-6 md:gap-x-14 md:gap-y-6 items-stretch flex-1">

            <input type="hidden" name="form-name" value="contact" />

            <p class="hp-field">
                <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <!-- Top-left: intro + identity fields. On desktop this is col 1, row 1. -->
            <div class="flex flex-col pt-10 md:pt-16 max-w-md md:col-start-1 md:row-start-1">
                <h1 class="wordmark text-4xl md:text-5xl tracking-tight leading-[1.05]">Contact us.</h1>
                <p class="wordmark mt-6 text-[17px] text-[#6B635A] leading-relaxed">
                    Mindchord is in closed beta. If you are interested in gaining access for personal or provider use, please don't hesitate to send us a message.
                </p>
                <p class="wordmark mt-3 text-[15px] text-[#2C2825]/70 leading-relaxed">
                    Or email
                    <a href="mailto:simchaorgel@gmail.com" class="text-[#C4704B] underline decoration-[#C4704B]/40 underline-offset-4 hover:decoration-[#C4704B] transition">simcha@mindchord.net</a>.
                </p>

                <div class="mt-8 space-y-5">
                    <div>
                        <label for="contact-name" class="field-label">Name</label>
                        <input id="contact-name" name="name" type="text" required class="field-input" autocomplete="name" />
                    </div>
                    <div>
                        <label for="contact-email" class="field-label">Email</label>
                        <input id="contact-email" name="email" type="email" required class="field-input" autocomplete="email" />
                    </div>
                </div>
            </div>

            <!-- Right side: textarea wrapper. On desktop spans both rows so it stays tall. -->
            <div class="flex flex-col md:col-start-2 md:row-span-2">
                <label for="contact-message" class="field-label md:sr-only">Message</label>
                <textarea id="contact-message" name="message" required
                          data-desktop-placeholder="Click anywhere to start typing…"
                          class="field-textarea-floating"></textarea>
            </div>

            <!-- Bottom-left: submit button. On mobile this comes after the textarea. -->
            <div class="flex justify-center md:justify-start md:col-start-1 md:row-start-2 md:self-start">
                <button type="submit"
                        class="relative isolate inline-flex items-center gap-2 px-7 py-3 text-[15px] text-[#F5F0EB] wordmark rounded-full ring-4 ring-transparent hover:ring-[#7A8F7E]/30 active:scale-95 transition-all duration-200 before:content-[''] before:absolute before:inset-0 before:-z-10 before:rounded-full before:bg-gradient-to-b before:from-[#869C8A] before:to-[#6A7F6E] before:transition-all before:duration-200 hover:before:brightness-90">
                    Send message
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                        <path d="M13.2 5.3a1 1 0 0 1 1.4 0l5.8 5.8a1.25 1.25 0 0 1 0 1.77l-5.8 5.83a1 1 0 0 1-1.42-1.41L17.18 13H4.75a1 1 0 1 1 0-2h12.43l-3.98-3.98a1 1 0 0 1 0-1.42Z"/>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</main>

<script>
    // Click anywhere in <main> (except on form controls/links or on the textarea's own
    // text) to relocate the textarea there and focus it. The textarea sizes itself via
    // CSS `field-sizing: content`; we just set its top/left and cap its max-width/height
    // so it can't spill past the page edges.
    (function () {
        const main = document.getElementById('contact-main');
        const textarea = document.getElementById('contact-message');
        if (!main || !textarea) return;
        // Desktop-only: enable click-anywhere + restore the "Click anywhere…" hint as
        // a placeholder. On mobile the stacked layout uses a visible label instead.
        if (!window.matchMedia('(min-width: 768px)').matches) return;
        textarea.placeholder = textarea.dataset.desktopPlaceholder || '';

        const EDGE_PAD = 16;
        // Textarea is confined to the right portion of <main> — clicks landing further
        // left snap to this boundary. Matches the grid's 2fr/3fr left/right split.
        const RIGHT_HALF_RATIO = 0.4;

        function placeAt(clientX, clientY) {
            const rect = main.getBoundingClientRect();
            const minX = rect.width * RIGHT_HALF_RATIO;
            let x = clientX - rect.left;
            let y = clientY - rect.top;
            if (x < minX) x = minX;
            if (y < 0) y = 0;
            textarea.style.left = x + 'px';
            textarea.style.top  = y + 'px';
            textarea.style.maxWidth  = Math.max(120, rect.width  - x - EDGE_PAD) + 'px';
            textarea.style.maxHeight = Math.max(40,  rect.height - y - EDGE_PAD) + 'px';
        }

        // Initial position — visually centred in the right half of <main>. We place
        // the textarea, then on the next frame measure its rendered size and shift
        // it so its centre aligns with the centre of the right half.
        function placeDefault() {
            const rect = main.getBoundingClientRect();
            const cx = rect.left + rect.width * 0.7;
            const cy = rect.top + rect.height * 0.4;
            placeAt(cx, cy);
            requestAnimationFrame(() => {
                placeAt(cx - textarea.offsetWidth / 2, cy - textarea.offsetHeight / 2);
            });
        }
        placeDefault();
        window.addEventListener('resize', placeDefault);

        main.addEventListener('mousedown', (e) => {
            if (e.target.closest('input, textarea, button, a, label')) return;
            const rect = main.getBoundingClientRect();
            // Ignore clicks landing in the left portion entirely.
            if (e.clientX - rect.left < rect.width * RIGHT_HALF_RATIO) return;
            e.preventDefault();
            placeAt(e.clientX, e.clientY);
            textarea.focus();
        });
    })();
</script>
